--- pie's nn is written in Crow (packages/nn): both modes run the one body
--- — a list read as a tensor where a function takes one, a value shaped
--- as PyTorch's, a gradient through the formulas and through a model's
--- layers (every parameter in one theta), and a misuse stopping with the
--- reason on the line of the call in the program.
use math
use nn
use nn.functional as F
use nn.rng

log[F.relu[[-1.0, 0.5, 2.0]]]
log[F.sigmoid[[0.0]]]
log[F.softmax[[1.0, 1.0]]]
log[fmt[F.gelu[[1.0]][0], decimals = 6]]
log[F.mse_loss[[1.0, 2.0], [1.0, 4.0]]]
log[fmt[F.binary_cross_entropy[[0.9, 0.1], [1.0, 0.0]], decimals = 6]]
log[fmt[F.cross_entropy[[[2.0, 0.0]], [0.0]], decimals = 6]]
log[F.linear[[[1.0, 2.0]], [[1.0, 1.0]], [0.5]]]

--- a matrix keeps its rank through an element-wise formula
m = [[1.0, -2.0], [3.0, 0.5]]
for r in F.relu[m]
    log[r]
log[type[F.sigmoid[m]]]
log[F.softmax[[1000.0, 1001.0, 1002.0]]]

--- the gradient of a loss through the formulas, in one run backward
fn loss[w, b, x, y]
    p = F.sigmoid[x * w + b]
    return F.binary_cross_entropy[flatten[p], y]

x = [[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]]
y = [1.0, 0.0, 1.0]
grads = grad[loss][[[0.5], [-0.5]], [[0.1]], x, y]
log[fmt[flatten[grads[0]][0], decimals = 6]]
log[fmt[flatten[grads[0]][1], decimals = 6]]
log[fmt[flatten[grads[1]][0], decimals = 6]]
log[grads[2].shape]

fn scores[w, x, c]
    return F.cross_entropy[x * w, c] + sum[F.gelu[x * w]] + max[F.relu[x * w]]

gc = grad[scores][[[0.5, -0.5, 0.1], [0.2, 0.3, -0.4]], x, [0.0, 2.0, 1.0]]
log[fmt[flatten[gc[0]][1], decimals = 6]]
log[fmt[flatten[gc[0]][5], decimals = 6]]

--- and through a model's layers: its parameters drawn as PyTorch draws
--- them, from a torch generator seeded alike in both modes
fn fitted[model, theta, x, y]
    return F.mse_loss[flatten[nn.forward[model, theta, x]], y]

model = nn.sequential[[nn.linear[2, 3], nn.tanh[], nn.linear[3, 1]]]
theta = nn.parameters[model, rng.manual_seed[4]].values
log[nn.size[model]]
g = grad[fitted][model, theta, tensor[x], tensor[y]]
log[len[g[0]] eq len[theta]]
log[fmt[flatten[g[0]][0], decimals = 9]]
log[fmt[flatten[g[0]][12], decimals = 9]]
for p in nn.named[model]
    log['`p.path` `p.dims`']

--- a misuse stops on this line, with the formula's own words
log[F.cross_entropy[[1.0, 2.0, 3.0], [7.0]]]
log['not reached']
