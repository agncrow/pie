--- The package held to nanoGPT in float64 (reference/reference.py): the
--- weights its GPT(config) draws from seed 1337, read from its own state
--- (safetensors, by nanoGPT's names); the tokens; the logits and the loss
--- at those weights; the loss before each of twenty steps of SGD and after
--- them; fifty ids generate draws at the SGD's weights; the loss before
--- each of twenty steps of nanoGPT's AdamW on batches of four blocks
--- get_batch draws; and, with shakespeare_char's dropout, five steps of
--- AdamW in training, ten ids generated in training and the loss in eval
--- after them. Numbers agree to 1e-9 relative (a matrix product's
--- accumulation order is the BLAS's own), the weights drawn to two units
--- of the last place, the tokens and the ids exactly.
use math, nn
use nn.rng, nn.optim, nn.safetensors
use chars, model, train

fn corpus[]
    return read['packages/gpt/reference/data/shakespeare_50k.txt']

fn expected[name]
    return load['packages/gpt/reference/expected/`name`.csv']

--- the reference's configuration
fn small[]
    return model.gpt[model.config[block_size = 16, vocab_size = 59, n_layer = 2, n_head = 2, n_embd = 32, bias = false]]

--- the reference's weights at seed 1337, as its checkpoint holds them
fn initial[net]
    return model.load[net, safetensors.load_file['packages/gpt/reference/expected/init.safetensors']]

fn ids[]
    return chars.tokens[corpus[], chars.vocab[corpus[]]]

--- a table's numbers as a list of ints
fn ints_of[t]
    out = []
    for x in math.flatten[t]
        out = push[out, int[x]]
    return out

--- the largest relative difference between two tensors of one shape
fn apart[a, b]
    return max[abs[a - b]] / max[abs[b]]

--- the vocabulary is the reference's, and the first block's tokens are
test the_tokens_are_the_references[]
    v = chars.vocab[corpus[]]
    len[v] eq 59
    v eq chars.characters[read['packages/gpt/reference/expected/vocab.txt']]
    slice[ids[], 0, 17] eq ints_of[expected['tokens']]

--- the widest gap between two tensors' numbers, in units of the last
--- place of the second's
fn ulps_apart[got, want]
    far = 0.0
    for i in range[len[want]]
        d = abs[got[i] - want[i]]
        if d gt 0.0
            far = max[far, d / (abs[want[i]] * 0.0000000000000002220446049250313)]
    return far

--- the weights drawn from seed 1337 are nanoGPT's, each number within two
--- units in its last place: a draw of normal_ goes through libm's log, cos
--- and sin, whose last digit two builds may round apart (nn.rng holds a
--- draw to one unit, held_rng.co), and its scaling by the std rounds once
--- more (22 of the 27,136 numbers differ, the widest by 1.55)
test the_weights_drawn_are_nanogpts[]
    net = small[]
    got = model.parameters[net, rng.manual_seed[1337]].values
    want = initial[net]
    len[got] eq len[want]
    ulps_apart[got, want] lte 2.0

--- the logits and the loss of the first block at those weights
test the_logits_at_init_are_the_references[]
    net = small[]
    theta = initial[net]
    b = train.in_order[ids[], 0, 16]
    got = model.logits[net, theta, b.x]
    got.shape eq [1, 16, 59]
    apart[math.reshape[got, 16, 59], expected['logits0']] lt 0.000000001
    abs[model.loss[net, theta, b.x, b.y] - expected['loss0'][0][0]] lt 0.000000001

--- twenty steps of SGD follow the reference's losses, and fifty ids drawn
--- at the weights they reach are the reference's
test twenty_steps_of_sgd_and_a_generation_follow_the_reference[]
    net = small[]
    fitted = train.fit[net, optim.sgd[initial[net], lr = 0.1], ids[], 20, rng.manual_seed[0]]
    len[fitted.losses] eq 20
    apart[math.tensor[fitted.losses], math.flatten[expected['sgd_losses']]] lt 0.000000001
    b = train.in_order[ids[], 0, 16]
    abs[train.batch_loss[net, fitted.opt.theta, b] - expected['sgd_after'][0][0]] lt 0.000000001
    made = model.generate[net, fitted.opt.theta, b.x, 50, rng.manual_seed[7], temperature = 0.8, top_k = 10]
    slice[ints_of[made.idx], 16, 66] eq ints_of[expected['generated']]

--- twenty steps of nanoGPT's AdamW, each on four blocks get_batch draws,
--- follow the reference's losses
test twenty_steps_of_adamw_follow_the_reference[]
    net = small[]
    opt = model.configure_optimizers[net, initial[net], 0.1, 0.01, 0.9, 0.95]
    fitted = train.fit_batches[net, opt, ids[], 20, 4, rng.manual_seed[1338]]
    apart[math.tensor[fitted.losses], math.flatten[expected['adamw_losses']]] lt 0.000000001

--- with shakespeare_char's dropout, 0.2: five steps of AdamW in training,
--- each pass's dropouts drawn after its batch, follow the reference's
--- losses; ten ids generated still in training, each step's dropouts drawn
--- before its multinomial, are the reference's; and so is the loss in eval
--- after them
test a_model_with_dropout_trains_and_draws_as_nanogpts_does[]
    net = model.gpt[model.config[block_size = 16, vocab_size = 59, n_layer = 2, n_head = 2, n_embd = 32, dropout = 0.2, bias = false]]
    opt = model.configure_optimizers[net, initial[net], 0.1, 0.01, 0.9, 0.95]
    fitted = train.fit_batches[net, opt, ids[], 5, 4, rng.manual_seed[1339]]
    apart[math.tensor[fitted.losses], math.flatten[expected['dropout_losses']]] lt 0.000000001
    start = math.reshape[math.tensor[slice[ids[], 0, 8]], 1, 8]
    made = model.generate[net, fitted.opt.theta, start, 10, rng.manual_seed[9]]
    slice[ints_of[made.idx], 8, 18] eq ints_of[expected['dropout_generated']]
    b = train.in_order[ids[], 0, 16]
    abs[train.batch_loss[model.eval[net], fitted.opt.theta, b] - expected['dropout_after'][0][0]] lt 0.000000001
