--- `use gpt.model`: nanoGPT's model.py (github.com/karpathy/nanoGPT) on
--- pie's nn, module for module and name for name. A GPT is token and
--- position embeddings (transformer.wte, transformer.wpe), blocks
--- (transformer.h.0, …) of a layer norm, causal self-attention (c_attn,
--- then nn.functional's scaled_dot_product_attention, then c_proj), a
--- layer norm and an MLP (c_fc, GELU, c_proj), each added to the stream,
--- then a final norm (transformer.ln_f) and the logits through lm_head,
--- whose weight is wte's. Every parameter is one flat theta, laid as nn
--- lays a module (each module's parts in the order of their names): a
--- nanoGPT checkpoint loads by its names (`load`, the tied lm_head.weight
--- read as wte's), `grad` differentiates the loss over theta, and an
--- nn.optim optimizer steps it (`configure_optimizers`, nanoGPT's AdamW).
--- A model is made in training, as a torch module is; in training with a
--- dropout, a forward pass reads the noise `dropout_noise` draws for it from
--- a torch generator, in the order nanoGPT's forward pass draws it, and
--- `eval` makes a model that draws none.
use math as m
use nn
use nn.functional as F
use nn.rng, nn.optim

--- nanoGPT's GPTConfig: the longest sequence, the vocabulary, the layers,
--- the heads, the width, the dropout's probability, and whether the linear
--- layers and the norms have biases
struct Config [block_size, vocab_size, n_layer, n_head, n_embd, dropout, bias]

--- config[…]: a configuration, its defaults GPT-2's (nanoGPT's)
fn config[block_size = 1024, vocab_size = 50304, n_layer = 12, n_head = 12, n_embd = 768, dropout = 0.0, bias = true]
    if n_embd % n_head ne 0
        halt['n_embd `n_embd` is no multiple of n_head `n_head`']
    if dropout lt 0.0 or dropout gt 1.0
        halt['dropout probability has to be between 0 and 1, but got `dropout`']
    return Config[block_size, vocab_size, n_layer, n_head, n_embd, dropout, bias]

--- a GPT: its configuration and its layers, named as nanoGPT's modules
struct GPT [config, layers]

--- gpt[config]: the model nanoGPT's GPT(config) builds, without its
--- numbers (`parameters` draws them, `load` reads a checkpoint's)
fn gpt[config]
    c = config
    e = c.n_embd
    blocks = []
    for i in range[c.n_layer]
        attn = nn.module[map[c_attn = nn.linear[e, 3 * e, bias = c.bias], c_proj = nn.linear[e, e, bias = c.bias], attn_dropout = nn.dropout[c.dropout], resid_dropout = nn.dropout[c.dropout]]]
        mlp = nn.module[map[c_fc = nn.linear[e, 4 * e, bias = c.bias], gelu = nn.gelu[], c_proj = nn.linear[4 * e, e, bias = c.bias], dropout = nn.dropout[c.dropout]]]
        blocks = push[blocks, nn.module[map[ln_1 = nn.layer_norm[[e], bias = c.bias], attn = attn, ln_2 = nn.layer_norm[[e], bias = c.bias], mlp = mlp]]]
    tr = nn.module[map[wte = nn.embedding[c.vocab_size, e], wpe = nn.embedding[c.block_size, e], drop = nn.dropout[c.dropout], h = nn.module_list[blocks], ln_f = nn.layer_norm[[e], bias = c.bias]]]
    return GPT[c, nn.module[map[transformer = tr]]]

--- train[net] and eval[net]: the model in training, its dropouts drawing,
--- and in evaluation, drawing none (nanoGPT's model.train(), model.eval())
fn train[net]
    return GPT[net.config, nn.train[net.layers]]

fn eval[net]
    return GPT[net.config, nn.eval[net.layers]]

--- dropout_noise[net, g, b, t]: the noise a forward pass over `b` sequences
--- of `t` ids reads in training, drawn from the generator g as nanoGPT's
--- forward pass draws it — transformer.drop's over the embeddings, then for
--- each block the attention's over its weights `[B, nh, T, T]` (F.scaled_
--- dot_product_attention's dropout_p), resid_dropout's and the MLP's, each
--- a bernoulli(1 − dropout) of its numbers in order — beside g past the
--- draws (`rng.Floats`); none in evaluation, or with a dropout of 0 or 1
fn dropout_noise[net, g, b, t]
    if not _draws[net]
        return rng.Floats[m.zeros[0], g]
    c = net.config
    e = c.n_embd
    keep = 1.0 - c.dropout
    d = rng.bernoulli[g, b * t * e, keep]
    out = d.values
    at = d.generator
    for i in range[c.n_layer]
        for n in [b * c.n_head * t * t, b * t * e, b * t * e]
            d = rng.bernoulli[at, n, keep]
            out = concat[out, d.values]
            at = d.generator
    return rng.Floats[out, at]

--- whether a forward pass draws: in training, with a dropout between 0 and
--- 1 (a dropout of 1 zeroes its numbers and draws none, as torch's)
fn _draws[net]
    p = net.config.dropout
    return net.layers.training and p gt 0.0 and p lt 1.0

--- how many numbers a training pass over `[b, t]` draws
fn _draw_count[c, b, t]
    e = c.n_embd
    return b * t * e + c.n_layer * (b * c.n_head * t * t + 2 * b * t * e)

--- the noise a forward pass over `[b, t]` reads, flat: none where the pass
--- draws none, else the noise given, which holds what dropout_noise draws
fn _noise_read[net, b, t, noise]
    if not _draws[net]
        return m.zeros[0]
    given = m.flatten[m.zeros[1] + noise]
    n = _draw_count[net.config, b, t]
    if len[given] eq 1 and given[0] lt 0.0
        halt['a GPT in training with a dropout of `net.config.dropout` reads its draws: hand it the noise model.dropout_noise draws for its ids, or run model.eval[net]']
    if len[given] ne n
        halt['the noise holds `len[given]` numbers, and a training pass over `b` sequences of `t` ids draws `n`']
    return given

--- n of the noise's numbers from `at` on, or none where the pass draws none
fn _piece[drops, at, n]
    if len[drops] eq 0
        return m.zeros[0]
    return slice[drops, at, at + n]

--- the parameters ----------------------------------------------------------

--- parameters[net, g]: theta as nanoGPT's GPT(config) draws it from the
--- torch generator g: each layer made as PyTorch makes it, drawing its
--- default (an embedding's normal, a linear layer's kaiming uniform), then
--- nanoGPT's _init_weights over the modules in the order apply meets them
--- — each embedding's and linear layer's weight normal of deviation 0.02,
--- every bias 0, wte's last since lm_head shares it — then each c_proj's
--- weight drawn again of deviation 0.02/√(2 · n_layer); a norm's weight
--- is 1. It answers theta beside g past the draws (`rng.Floats`)
fn parameters[net, g]
    c = net.config
    e = c.n_embd
    v = c.vocab_size
    --- the layers made, each drawing its default, which is replaced below
    at = rng.normal[g, v * e].generator
    at = rng.normal[at, c.block_size * e].generator
    for i in range[c.n_layer]
        at = _made_linear[at, e, 3 * e, c.bias]
        at = _made_linear[at, e, e, c.bias]
        at = _made_linear[at, e, 4 * e, c.bias]
        at = _made_linear[at, 4 * e, e, c.bias]
    at = _made_linear[at, e, v, false]
    --- _init_weights, as apply meets the modules: wte, wpe, each block's
    --- c_attn, c_proj, c_fc and c_proj, then lm_head, whose weight is wte's
    state = map[]
    d = rng.normal[at, v * e, 0.0, 0.02]
    d = rng.normal[d.generator, c.block_size * e, 0.0, 0.02]
    state['transformer.wpe.weight'] = d.values
    for i in range[c.n_layer]
        d = rng.normal[d.generator, 3 * e * e, 0.0, 0.02]
        state['transformer.h.`i`.attn.c_attn.weight'] = d.values
        d = rng.normal[d.generator, e * e, 0.0, 0.02]
        d = rng.normal[d.generator, 4 * e * e, 0.0, 0.02]
        state['transformer.h.`i`.mlp.c_fc.weight'] = d.values
        d = rng.normal[d.generator, 4 * e * e, 0.0, 0.02]
    d = rng.normal[d.generator, v * e, 0.0, 0.02]
    state['transformer.wte.weight'] = d.values
    --- the residual projections again, smaller for a deeper model
    small = 0.02 / sqrt[2.0 * float[c.n_layer]]
    for i in range[c.n_layer]
        d = rng.normal[d.generator, e * e, 0.0, small]
        state['transformer.h.`i`.attn.c_proj.weight'] = d.values
        d = rng.normal[d.generator, 4 * e * e, 0.0, small]
        state['transformer.h.`i`.mlp.c_proj.weight'] = d.values
    --- a norm's weight 1, every bias 0
    for p in nn.named[net.layers]
        if not (p.path in state)
            n = 1
            for size in p.dims
                n = n * size
            pieces = split[p.path, '.']
            if pieces[len[pieces] - 1] eq 'bias'
                state[p.path] = m.zeros[n]
            else
                state[p.path] = m.ones[n]
    return rng.Floats[nn.from_state[net.layers, state], d.generator]

--- a linear layer made (nn.Linear's reset_parameters): its weight's kaiming
--- uniform, then its bias's uniform, both within ±1/√ins; the generator
--- past them
fn _made_linear[g, ins, outs, bias]
    bound = 1.0 / sqrt[float[ins]]
    d = rng.uniform[g, outs * ins, -bound, bound]
    if not bias
        return d.generator
    return rng.uniform[d.generator, outs, -bound, bound].generator

--- load[net, state]: theta from a nanoGPT checkpoint's state, by name
--- (nn.from_state: lm_head.weight, wte's, is not read)
fn load[net, state]
    return nn.from_state[net.layers, state]

--- state[net, theta]: the parameters by name as nanoGPT's state_dict lays
--- them, lm_head.weight beside wte's
fn state[net, theta]
    out = nn.state[net.layers, theta]
    out['lm_head.weight'] = out['transformer.wte.weight']
    return out

--- the forward pass ------------------------------------------------------------

--- logits[net, theta, idx, noise]: the logits of each position of each
--- sequence of idx `[B, T]` (token ids, T at most block_size), `[B, T,
--- vocab_size]`; in training with a dropout, its dropouts read the noise
--- dropout_noise draws for idx
fn logits[net, theta, idx, noise = -1.0]
    c = net.config
    d = idx.shape
    if len[d] ne 2
        halt['idx is a batch of sequences, [B, T], and has `len[d]` axes']
    b = d[0]
    t = d[1]
    if t gt c.block_size
        halt['Cannot forward sequence of length `t`, block size is only `c.block_size`']
    e = c.n_embd
    drops = _noise_read[net, b, t, noise]
    tr = nn.part[net.layers, 'transformer']
    tok = nn.forward[nn.part[tr, 'wte'], theta, idx]
    pos = nn.forward[nn.part[tr, 'wpe'], theta, m.tensor[range[t]]]
    x = m.reshape[m.reshape[tok, b, t * e] + m.reshape[pos, 1, t * e], b, t, e]
    x = nn.forward[nn.part[tr, 'drop'], theta, x, noise = _piece[drops, 0, b * t * e]]
    at = b * t * e
    per = _draw_count[c, b, t] - at
    if c.n_layer gt 0
        per = per / c.n_layer
    for block in nn.part[tr, 'h'].parts
        x = _block[block, theta, x, c, _piece[drops, at, per]]
        at = at + per
    x = nn.forward[nn.part[tr, 'ln_f'], theta, x]
    --- lm_head: its weight is wte's (each position a row, as nn's linear
    --- layers run)
    rows = F.linear[m.reshape[x, b * t, e], nn.param[net.layers, theta, 'transformer.wte.weight']]
    return m.reshape[rows, b, t, c.vocab_size]

--- loss[net, theta, idx, targets, noise]: the mean cross-entropy of every
--- position's logits against its target, targets of idx's shape
fn loss[net, theta, idx, targets, noise = -1.0]
    z = logits[net, theta, idx, noise = noise]
    v = net.config.vocab_size
    return F.cross_entropy[m.reshape[z, len[m.flatten[z]] / v, v], m.flatten[targets], ignore_index = -1]

--- a block: x plus the attention over its norm, plus the MLP over its
--- norm, the attention's dropouts reading the first of its noise
fn _block[block, theta, x, c, drops]
    d = x.shape
    rows = d[0] * d[1] * c.n_embd
    first = d[0] * c.n_head * d[1] * d[1] + rows
    x = x + _attention[nn.part[block, 'attn'], theta, nn.forward[nn.part[block, 'ln_1'], theta, x], c, _piece[drops, 0, first]]
    return x + _mlp[nn.part[block, 'mlp'], theta, nn.forward[nn.part[block, 'ln_2'], theta, x], _piece[drops, first, rows]]

--- causal self-attention over x `[B, T, C]`: c_attn's queries, keys and
--- values split into n_head heads `[B, nh, T, hs]`, each position
--- attending to itself and those before it (its weights dropped in
--- training, as F.scaled_dot_product_attention's dropout_p drops them), the
--- heads joined back `[B, T, C]`, projected by c_proj and dropped by
--- resid_dropout
fn _attention[attn, theta, x, c, drops]
    d = x.shape
    b = d[0]
    t = d[1]
    nh = c.n_head
    hs = c.n_embd / nh
    qkv = m.flatten[nn.forward[nn.part[attn, 'c_attn'], theta, x]]
    q = m.reshape[qkv[_heads[b, t, nh, hs, 0]], b, nh, t, hs]
    k = m.reshape[qkv[_heads[b, t, nh, hs, 1]], b, nh, t, hs]
    v = m.reshape[qkv[_heads[b, t, nh, hs, 2]], b, nh, t, hs]
    p = 0.0
    if attn.training
        p = c.dropout
    weights = b * nh * t * t
    y = m.flatten[F.scaled_dot_product_attention[q, k, v, dropout_p = p, is_causal = true, noise = _piece[drops, 0, weights]]]
    out = nn.forward[nn.part[attn, 'c_proj'], theta, m.reshape[y[_joined[b, t, nh, hs]], b, t, c.n_embd]]
    return nn.forward[nn.part[attn, 'resid_dropout'], theta, out, noise = _piece[drops, weights, b * t * c.n_embd]]

--- where one of q, k and v (`part` 0, 1 or 2) lies in c_attn's output
--- `[B, T, 3C]`, laid `[B, nh, T, hs]` (split, view, then transpose(1, 2))
fn _heads[b, t, nh, hs, part]
    e = nh * hs
    firsts = []
    for i in range[b * nh]
        firsts = push[firsts, float[(i / nh) * t * 3 * e + part * e + (i % nh) * hs]]
    pos = m.reshape[m.tensor[firsts], b * nh, 1, 1] + m.reshape[m.tensor[range[t]] * float[3 * e], 1, t, 1] + m.reshape[m.tensor[range[hs]], 1, 1, hs]
    return m.flatten[pos]

--- where each number of the heads' output `[B, nh, T, hs]` lies, laid
--- `[B, T, C]` (transpose(1, 2), then view)
fn _joined[b, t, nh, hs]
    firsts = []
    for i in range[b * t]
        firsts = push[firsts, float[(i / t) * nh * t * hs + (i % t) * hs]]
    pos = m.reshape[m.tensor[firsts], b * t, 1, 1] + m.reshape[m.tensor[range[nh]] * float[t * hs], 1, nh, 1] + m.reshape[m.tensor[range[hs]], 1, 1, hs]
    return m.flatten[pos]

--- the MLP: c_fc, GELU, c_proj, then its dropout
fn _mlp[mlp, theta, x, drops]
    h = nn.forward[nn.part[mlp, 'c_fc'], theta, x]
    h = nn.forward[nn.part[mlp, 'gelu'], theta, h]
    h = nn.forward[nn.part[mlp, 'c_proj'], theta, h]
    return nn.forward[nn.part[mlp, 'dropout'], theta, h, noise = drops]

--- generation ----------------------------------------------------------------

--- what generation answers: the ids `[B, T + max_new_tokens]` and the
--- generator past its draws
struct Generated [idx, generator]

--- generate[net, theta, idx, max_new_tokens, g, temperature, top_k]: idx
--- `[B, T]` continued by max_new_tokens ids, as nanoGPT's generate draws
--- them: each step reads the last block_size ids of each sequence (a model
--- in training draws its dropouts' noise for them first), divides the last
--- position's logits by the temperature, keeps the top_k largest (all
--- where top_k is 0) and draws the next id from their softmax by
--- torch.multinomial from the generator g (`Generated`)
fn generate[net, theta, idx, max_new_tokens, g, temperature = 1.0, top_k = 0]
    out = idx
    at = g
    bs = net.config.block_size
    v = net.config.vocab_size
    for step in range[max_new_tokens]
        t = out.shape[1]
        cond = out
        if t gt bs
            cond = m.transpose[slice[m.transpose[out], t - bs, t]]
        n = cond.shape[0]
        w = cond.shape[1]
        noisy = dropout_noise[net, at, n, w]
        at = noisy.generator
        z = logits[net, theta, cond, noise = noisy.values]
        rows = m.reshape[z, n * w, v]
        nexts = []
        for b in range[n]
            last = rows[b * w + w - 1] / temperature
            if top_k gt 0
                last = _top_k[last, min[top_k, v]]
            drawn = rng.multinomial[at, F.softmax[last, 0], 1]
            nexts = push[nexts, float[drawn.values[0]]]
            at = drawn.generator
        out = concat[out, m.reshape[m.tensor[nexts], n, 1], axis = 1]
    return Generated[out, at]

--- the logits with every one below the k-th largest made −∞ (torch.topk's
--- last, then the masked assignment)
fn _top_k[z, k]
    ordered = []
    for x in z
        ordered = push[ordered, x]
    ordered = sort[ordered]
    kth = ordered[len[ordered] - k]
    kept = []
    for x in z
        if x lt kth
            kept = push[kept, -inf]
        else
            kept = push[kept, x]
    return m.tensor[kept]

--- training -------------------------------------------------------------------

--- configure_optimizers[net, theta, weight_decay, learning_rate, beta1,
--- beta2]: nanoGPT's AdamW over theta: every weight of two axes or more
--- decayed by weight_decay, the norms' weights and the biases not
fn configure_optimizers[net, theta, weight_decay, learning_rate, beta1, beta2]
    decay = []
    rest = []
    for p in nn.named[net.layers]
        if len[p.dims] gte 2
            decay = push[decay, p.path]
        else
            rest = push[rest, p.path]
    opt = optim.adamw[theta, lr = learning_rate, beta1 = beta1, beta2 = beta2]
    groups = [optim.param_group[nn.ranges[net.layers, decay], map[weight_decay = weight_decay]]]
    if len[rest] gt 0
        groups = push[groups, optim.param_group[nn.ranges[net.layers, rest], map[weight_decay = 0.0]]]
    return optim.grouped[opt, groups]

--- the shapes of the parameters, and the loss at nanoGPT's draw is the
--- loss of an uninformed guess, about ln(vocab)
test the_parameters_have_nanogpts_names_and_shapes[]
    net = gpt[config[block_size = 16, vocab_size = 59, n_layer = 2, n_head = 2, n_embd = 32, bias = false]]
    named = nn.named[net.layers]
    len[named] eq 15
    theta = parameters[net, rng.manual_seed[1]].values
    len[theta] eq 1888 + 512 + 2 * (32 + 3072 + 1024 + 32 + 4096 + 4096) + 32
    nn.param[net.layers, theta, 'transformer.wte.weight'].shape eq [59, 32]
    nn.param[net.layers, theta, 'transformer.h.1.attn.c_attn.weight'].shape eq [96, 32]
    nn.param[net.layers, theta, 'transformer.h.0.mlp.c_proj.weight'].shape eq [32, 128]
    x = m.tensor[[[1, 2, 3, 4]]]
    y = m.tensor[[[2, 3, 4, 5]]]
    logits[net, theta, x].shape eq [1, 4, 59]
    abs[loss[net, theta, x, y] - ln[59.0]] lt 0.2
    with_bias = gpt[config[block_size = 8, vocab_size = 11, n_layer = 1, n_head = 4, n_embd = 8]]
    len[nn.named[with_bias.layers]] eq 16
