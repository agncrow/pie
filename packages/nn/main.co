--- `use nn`: PyTorch's torch.nn. A layer is a record (`Layer`) made by a
--- function named as PyTorch's class, in lowercase — `nn.linear[4, 8]` is
--- nn.Linear(4, 8) — and a model is a layer of parts (`nn.sequential`,
--- `nn.module`). Every parameter of a model is one flat tensor, theta:
--- `nn.parameters[model, g]` draws PyTorch's default values from a torch
--- generator (`nn.rng`) as PyTorch's modules draw them, laid as PyTorch's
--- state_dict lays them (each layer's own first, then its parts'), and
--- `nn.forward[model, theta, x]` runs the
--- model reading each layer's parameters from theta, so
--- `grad[loss][model, theta, batch]` differentiates every parameter at once
--- (the model and a batch, records, are constants of the run). A layer's
--- buffers — a batch norm's running statistics — are its record's own
--- (`held`); `nn.tracked` answers the model with them moved by a batch, as
--- PyTorch's forward pass moves them in training. The functions a model is
--- written in are `nn.functional`'s.
use math as m
use functional, shapes, rng, windows

--- a layer: its form (`linear`, `relu`, `sequential`, …), its name in its
--- parent, where its parameters begin in theta, how many are its own and
--- how many in all (its own, then its parts'), its sizes, numbers, word
--- and flags (each form's options, in the order its maker takes them),
--- whether it trains, its buffers and its parts
struct Layer [form, name, at, own, size, ints, floats, word, flags, training, held, parts]

--- a parameter: its name in the state (`0.weight`), where its numbers
--- begin in theta, and its sizes
struct Named [path, at, dims]

--- a recurrent layer's answer (`nn.recurrent`): its output at every step,
--- its last hidden state and, for an LSTM, its last cell state (no
--- numbers otherwise)
struct Recurrent [output, h, c]

--- a list of ints and a list of floats, whatever list or vector they are
--- given as (a list of whole numbers written down is a vector of them)
fn _sizes[given]
    out = []
    for s in given
        out = push[out, int[s]]
    return out

fn _reals[given]
    out = []
    for v in given
        out = push[out, float[v]]
    return out

--- a layer of no parts, holding `own` parameters
fn _leaf[form, own, ints, floats, word, flags]
    return Layer[form, '', 0, own, own, _sizes[ints], _reals[floats], word, flags, true, m.zeros[0], []]

--- a layer of no parameters and no parts
fn _plain[form, ints, floats, word]
    return _leaf[form, 0, ints, floats, word, [false]]

--- the layers ---------------------------------------------------------------

--- linear[ins, outs]: x · Wᵀ + b, W `[outs, ins]` (nn.Linear)
fn linear[ins, outs, bias = true]
    own = outs * ins
    if bias
        own = own + outs
    return _leaf['linear', own, [ins, outs], [0.0], '', [bias]]

--- bilinear[in1, in2, outs]: x1ᵀ · W[k] · x2 + b[k], W `[outs, in1, in2]`
--- (nn.Bilinear; run by nn.forward2, of two inputs)
fn bilinear[in1, in2, outs, bias = true]
    own = outs * in1 * in2
    if bias
        own = own + outs
    return _leaf['bilinear', own, [in1, in2, outs], [0.0], '', [bias]]

--- embedding[count, dim]: a row of `dim` numbers for each of `count` ids
--- (nn.Embedding)
fn embedding[count, dim]
    return _leaf['embedding', count * dim, [count, dim], [0.0], '', [false]]

--- layer_norm[shape]: each item over its last len(shape) axes, scaled and
--- moved per number when affine (nn.LayerNorm)
fn layer_norm[shape, eps = 0.00001, affine = true, bias = true]
    n = shapes.product[shape]
    own = 0
    if affine
        own = n
        if bias
            own = 2 * n
    return _leaf['layer_norm', own, shape, [eps], '', [affine, bias]]

--- rms_norm[shape]: each item over the root mean square of its last
--- len(shape) axes, scaled per number when affine (nn.RMSNorm)
fn rms_norm[shape, eps = 0.0000000000000002220446049250313, affine = true]
    own = 0
    if affine
        own = shapes.product[shape]
    return _leaf['rms_norm', own, shape, [eps], '', [affine]]

--- batch_norm[features]: each channel (axis 1) over the batch's mean and
--- variance in training, over the running ones it keeps otherwise
--- (nn.BatchNorm1d, 2d and 3d: one layer, any rank)
fn batch_norm[features, eps = 0.00001, momentum = 0.1, affine = true, track = true]
    own = 0
    if affine
        own = 2 * features
    out = _leaf['batch_norm', own, [features], [eps, momentum], '', [affine, track]]
    out.held = concat[concat[m.zeros[features], m.ones[features]], m.zeros[1]]
    return out

--- group_norm[groups, channels]: each item's channels in `groups` groups,
--- each group over its own numbers (nn.GroupNorm)
fn group_norm[groups, channels, eps = 0.00001, affine = true]
    own = 0
    if affine
        own = 2 * channels
    return _leaf['group_norm', own, [groups, channels], [eps], '', [affine]]

--- instance_norm[features]: each channel of each item over its own
--- numbers (nn.InstanceNorm1d, 2d and 3d; no running statistics)
fn instance_norm[features, eps = 0.00001, affine = false]
    own = 0
    if affine
        own = 2 * features
    return _leaf['instance_norm', own, [features], [eps], '', [affine]]

--- prelu[count]: x where positive, a learned slope times x elsewhere, one
--- slope or one per channel (nn.PReLU)
fn prelu[count = 1, init = 0.25]
    return _leaf['prelu', count, [count], [init], '', [false]]

--- dropout[p]: each number kept with probability 1 − p in training
--- (nn.Dropout)
fn dropout[p = 0.5]
    return _plain['dropout', [0], [p], '']

--- identity[]: x itself (nn.Identity)
fn identity[]
    return _plain['identity', [0], [0.0], '']

--- flatten[start, end]: axes start to end joined into one (nn.Flatten)
fn flatten[start = 1, end = -1]
    return _plain['flatten', [start, end], [0.0], '']

--- unflatten[dim, sizes]: axis dim laid as `sizes` (nn.Unflatten)
fn unflatten[dim, sizes]
    return _plain['unflatten', concat[[dim], _sizes[sizes]], [0.0], '']

--- the layers over windows ------------------------------------------------------

--- conv1d[ins, outs, kernel_size, stride, padding, dilation, groups, bias,
--- padding_mode]: a convolution over one spatial axis (nn.Conv1d), its
--- weight `[outs, ins / groups, k]` drawn as PyTorch's — kaiming_uniform
--- with a = √5 over ins / groups · k inputs — and its bias within
--- ±1/√(ins / groups · k); padding is an int, one per axis, 'valid' or
--- 'same', and padding_mode 'zeros', 'reflect', 'replicate' or 'circular'
--- (the input padded so, then convolved). conv2d and conv3d alike
fn conv1d[ins, outs, kernel_size, stride = 1, padding = 0, dilation = 1, groups = 1, bias = true, padding_mode = 'zeros']
    return _conv_layer[1, ins, outs, kernel_size, stride, padding, dilation, groups, bias, padding_mode]

fn conv2d[ins, outs, kernel_size, stride = 1, padding = 0, dilation = 1, groups = 1, bias = true, padding_mode = 'zeros']
    return _conv_layer[2, ins, outs, kernel_size, stride, padding, dilation, groups, bias, padding_mode]

fn conv3d[ins, outs, kernel_size, stride = 1, padding = 0, dilation = 1, groups = 1, bias = true, padding_mode = 'zeros']
    return _conv_layer[3, ins, outs, kernel_size, stride, padding, dilation, groups, bias, padding_mode]

fn _conv_layer[d, ins, outs, kernel_size, stride, padding, dilation, groups, bias, padding_mode]
    if groups lt 1 or ins % groups ne 0
        halt['in_channels must be divisible by groups']
    if outs % groups ne 0
        halt['out_channels must be divisible by groups']
    if not (padding_mode in ['zeros', 'reflect', 'replicate', 'circular'])
        halt['padding_mode must be one of zeros, reflect, replicate and circular, but got padding_mode=\'`padding_mode`\'']
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = windows.each[stride, d, 'stride']
    dl = windows.each[dilation, d, 'dilation']
    pads = windows.padding[padding, d, kernel, dl, st, 'conv']
    own = outs * (ins / groups) * shapes.product[kernel]
    if bias
        own = own + outs
    ints = concat[concat[concat[[d, ins, outs, groups], kernel], concat[st, pads.low]], concat[pads.high, dl]]
    return _leaf['conv', own, ints, [0.0], padding_mode, [bias]]

--- conv_transpose1d[ins, outs, kernel_size, stride, padding,
--- output_padding, groups, bias, dilation]: a transposed convolution
--- (nn.ConvTranspose1d), its weight `[ins, outs / groups, k]` drawn as
--- PyTorch's — kaiming_uniform with a = √5 over outs / groups · k inputs,
--- the bias within ±1/√that; conv_transpose2d and conv_transpose3d alike
fn conv_transpose1d[ins, outs, kernel_size, stride = 1, padding = 0, output_padding = 0, groups = 1, bias = true, dilation = 1]
    return _transposed_layer[1, ins, outs, kernel_size, stride, padding, output_padding, groups, bias, dilation]

fn conv_transpose2d[ins, outs, kernel_size, stride = 1, padding = 0, output_padding = 0, groups = 1, bias = true, dilation = 1]
    return _transposed_layer[2, ins, outs, kernel_size, stride, padding, output_padding, groups, bias, dilation]

fn conv_transpose3d[ins, outs, kernel_size, stride = 1, padding = 0, output_padding = 0, groups = 1, bias = true, dilation = 1]
    return _transposed_layer[3, ins, outs, kernel_size, stride, padding, output_padding, groups, bias, dilation]

fn _transposed_layer[d, ins, outs, kernel_size, stride, padding, output_padding, groups, bias, dilation]
    if groups lt 1 or ins % groups ne 0
        halt['in_channels must be divisible by groups']
    if outs % groups ne 0
        halt['out_channels must be divisible by groups']
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = windows.each[stride, d, 'stride']
    p = windows.each[padding, d, 'padding']
    op = windows.each[output_padding, d, 'output_padding']
    dl = windows.each[dilation, d, 'dilation']
    own = ins * (outs / groups) * shapes.product[kernel]
    if bias
        own = own + outs
    ints = concat[concat[concat[[d, ins, outs, groups], kernel], concat[st, p]], concat[op, dl]]
    return _leaf['conv_transpose', own, ints, [0.0], 'zeros', [bias]]

--- a layer's spatial options, k of them in turn after its four numbers
--- (the axes, and three more)
fn _part[layer, k]
    d = layer.ints[0]
    return slice[layer.ints, 4 + k * d, 4 + (k + 1) * d]

--- max_pool1d[kernel_size, stride, padding, dilation, ceil_mode]: the
--- largest number of each window (nn.MaxPool1d; stride 0 is the
--- kernel's); max_pool2d and max_pool3d alike
fn max_pool1d[kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool_layer[1, kernel_size, stride, padding, dilation, ceil_mode]

fn max_pool2d[kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool_layer[2, kernel_size, stride, padding, dilation, ceil_mode]

fn max_pool3d[kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool_layer[3, kernel_size, stride, padding, dilation, ceil_mode]

fn _max_pool_layer[d, kernel_size, stride, padding, dilation, ceil_mode]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = functional.pool_stride[windows.each[stride, d, 'stride'], kernel]
    ints = concat[concat[[d, 0, 0, 0], kernel], concat[concat[st, windows.each[padding, d, 'padding']], windows.each[dilation, d, 'dilation']]]
    return _leaf['max_pool', 0, ints, [0.0], '', [ceil_mode]]

--- avg_pool1d[kernel_size, stride, padding, ceil_mode,
--- count_include_pad]: the mean of each window (nn.AvgPool1d);
--- avg_pool2d and avg_pool3d alike, with divisor_override
fn avg_pool1d[kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true]
    return _avg_pool_layer[1, kernel_size, stride, padding, ceil_mode, count_include_pad, 0]

fn avg_pool2d[kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true, divisor_override = 0]
    return _avg_pool_layer[2, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override]

fn avg_pool3d[kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true, divisor_override = 0]
    return _avg_pool_layer[3, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override]

fn _avg_pool_layer[d, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = functional.pool_stride[windows.each[stride, d, 'stride'], kernel]
    ints = concat[concat[[d, divisor_override, 0, 0], kernel], concat[st, windows.each[padding, d, 'padding']]]
    return _leaf['avg_pool', 0, ints, [0.0], '', [ceil_mode, count_include_pad]]

--- lp_pool1d[norm_type, kernel_size, stride, ceil_mode]: the p-norm of
--- each window (nn.LPPool1d); lp_pool2d and lp_pool3d alike
fn lp_pool1d[norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool_layer[1, norm_type, kernel_size, stride, ceil_mode]

fn lp_pool2d[norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool_layer[2, norm_type, kernel_size, stride, ceil_mode]

fn lp_pool3d[norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool_layer[3, norm_type, kernel_size, stride, ceil_mode]

fn _lp_pool_layer[d, norm_type, kernel_size, stride, ceil_mode]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = functional.pool_stride[windows.each[stride, d, 'stride'], kernel]
    return _leaf['lp_pool', 0, concat[concat[[d, 0, 0, 0], kernel], st], [float[norm_type]], '', [ceil_mode]]

--- adaptive_avg_pool1d[output_size]: each plane in output_size windows,
--- as even as whole numbers allow, and each window's mean
--- (nn.AdaptiveAvgPool1d); 2d and 3d alike, and the adaptive_max_pool
--- layers each window's largest number
fn adaptive_avg_pool1d[output_size]
    return _leaf['adaptive_avg_pool', 0, concat[[1, 0, 0, 0], windows.each[output_size, 1, 'output_size']], [0.0], '', [false]]

fn adaptive_avg_pool2d[output_size]
    return _leaf['adaptive_avg_pool', 0, concat[[2, 0, 0, 0], windows.each[output_size, 2, 'output_size']], [0.0], '', [false]]

fn adaptive_avg_pool3d[output_size]
    return _leaf['adaptive_avg_pool', 0, concat[[3, 0, 0, 0], windows.each[output_size, 3, 'output_size']], [0.0], '', [false]]

fn adaptive_max_pool1d[output_size]
    return _leaf['adaptive_max_pool', 0, concat[[1, 0, 0, 0], windows.each[output_size, 1, 'output_size']], [0.0], '', [false]]

fn adaptive_max_pool2d[output_size]
    return _leaf['adaptive_max_pool', 0, concat[[2, 0, 0, 0], windows.each[output_size, 2, 'output_size']], [0.0], '', [false]]

fn adaptive_max_pool3d[output_size]
    return _leaf['adaptive_max_pool', 0, concat[[3, 0, 0, 0], windows.each[output_size, 3, 'output_size']], [0.0], '', [false]]

--- zero_pad1d[padding]: zeros added before and after the last axis
--- (nn.ZeroPad1d): padding one int for both sides or [before, after];
--- the 2d and 3d forms the last two and three axes, PyTorch's order
--- (left, right, top, bottom, front, back). constant_pad adds `value`,
--- reflection_pad mirrors, replication_pad repeats the edge and
--- circular_pad wraps around
fn zero_pad1d[padding]
    return _pad_layer[1, padding, 'constant', 0.0]

fn zero_pad2d[padding]
    return _pad_layer[2, padding, 'constant', 0.0]

fn zero_pad3d[padding]
    return _pad_layer[3, padding, 'constant', 0.0]

fn constant_pad1d[padding, value]
    return _pad_layer[1, padding, 'constant', float[value]]

fn constant_pad2d[padding, value]
    return _pad_layer[2, padding, 'constant', float[value]]

fn constant_pad3d[padding, value]
    return _pad_layer[3, padding, 'constant', float[value]]

fn reflection_pad1d[padding]
    return _pad_layer[1, padding, 'reflect', 0.0]

fn reflection_pad2d[padding]
    return _pad_layer[2, padding, 'reflect', 0.0]

fn reflection_pad3d[padding]
    return _pad_layer[3, padding, 'reflect', 0.0]

fn replication_pad1d[padding]
    return _pad_layer[1, padding, 'replicate', 0.0]

fn replication_pad2d[padding]
    return _pad_layer[2, padding, 'replicate', 0.0]

fn replication_pad3d[padding]
    return _pad_layer[3, padding, 'replicate', 0.0]

fn circular_pad1d[padding]
    return _pad_layer[1, padding, 'circular', 0.0]

fn circular_pad2d[padding]
    return _pad_layer[2, padding, 'circular', 0.0]

fn circular_pad3d[padding]
    return _pad_layer[3, padding, 'circular', 0.0]

fn _pad_layer[d, padding, mode, value]
    return _plain['pad', windows.each[padding, 2 * d, 'padding'], [value], mode]

--- upsample[size, scale_factor, mode, align_corners]: F.interpolate as a
--- layer (nn.Upsample); upsampling_nearest2d and upsampling_bilinear2d
--- its forms PyTorch names (the latter's corners aligned)
fn upsample[size = 0, scale_factor = 0.0, mode = 'nearest', align_corners = false]
    sizes = []
    if str[size] ne '0'
        sizes = windows.listed[size, 'size']
    return _leaf['upsample', 0, concat[[len[sizes]], sizes], m.flatten[m.tensor[[scale_factor]]] + 0.0, mode, [align_corners]]

fn upsampling_nearest2d[size = 0, scale_factor = 0.0]
    return upsample[size, scale_factor, 'nearest', false]

fn upsampling_bilinear2d[size = 0, scale_factor = 0.0]
    return upsample[size, scale_factor, 'bilinear', true]

--- pixel_shuffle[r], pixel_unshuffle[r], channel_shuffle[groups]: the
--- functions of those names as layers (nn.PixelShuffle, nn.PixelUnshuffle,
--- nn.ChannelShuffle)
fn pixel_shuffle[r]
    return _plain['pixel_shuffle', [r], [0.0], '']

fn pixel_unshuffle[r]
    return _plain['pixel_unshuffle', [r], [0.0], '']

fn channel_shuffle[groups]
    return _plain['channel_shuffle', [groups], [0.0], '']

--- dropout1d[p], dropout2d[p], dropout3d[p]: whole channels dropped in
--- training (nn.Dropout1d, nn.Dropout2d, nn.Dropout3d)
fn dropout1d[p = 0.5]
    return _plain['dropout_channels', [1], [p], '']

fn dropout2d[p = 0.5]
    return _plain['dropout_channels', [2], [p], '']

fn dropout3d[p = 0.5]
    return _plain['dropout_channels', [3], [p], '']

--- the recurrent layers -------------------------------------------------------

--- rnn[input_size, hidden_size, num_layers, nonlinearity, bias,
--- batch_first, dropout, bidirectional]: an Elman network (nn.RNN) — at
--- each step h′ = tanh(h · w_hhᵀ + b_hh + x · w_ihᵀ + b_ih), relu where
--- nonlinearity says — of num_layers layers, each over the one before's
--- output, both ways where bidirectional, dropout between layers in
--- training. Its parameters are PyTorch's, named and laid as PyTorch's
--- (weight_ih_l0, weight_hh_l0, bias_ih_l0, bias_hh_l0, …, `_reverse`
--- the other way) and drawn as PyTorch's: each uniform within ±1/√hidden.
--- nn.forward answers the output; nn.recurrent the last states too
fn rnn[input_size, hidden_size, num_layers = 1, nonlinearity = 'tanh', bias = true, batch_first = false, dropout = 0.0, bidirectional = false]
    if nonlinearity ne 'tanh' and nonlinearity ne 'relu'
        halt['Unknown nonlinearity \'`nonlinearity`\'. Select from \'tanh\' or \'relu\'.']
    return _recurrent_layer['rnn', input_size, hidden_size, num_layers, bias, batch_first, dropout, bidirectional, 0, nonlinearity]

--- lstm[input_size, hidden_size, num_layers, bias, batch_first, dropout,
--- bidirectional, proj_size]: a long short-term memory (nn.LSTM), its
--- gates i, f, g, o in that order; with proj_size its hidden state
--- projected to that many numbers (weight_hr)
fn lstm[input_size, hidden_size, num_layers = 1, bias = true, batch_first = false, dropout = 0.0, bidirectional = false, proj_size = 0]
    if proj_size lt 0
        halt['proj_size should be a positive integer or zero to disable projections']
    if proj_size gt 0 and proj_size gte hidden_size
        halt['proj_size has to be smaller than hidden_size']
    return _recurrent_layer['lstm', input_size, hidden_size, num_layers, bias, batch_first, dropout, bidirectional, proj_size, '']

--- gru[input_size, hidden_size, num_layers, bias, batch_first, dropout,
--- bidirectional]: a gated recurrent unit (nn.GRU), its gates r, z, n in
--- that order
fn gru[input_size, hidden_size, num_layers = 1, bias = true, batch_first = false, dropout = 0.0, bidirectional = false]
    return _recurrent_layer['gru', input_size, hidden_size, num_layers, bias, batch_first, dropout, bidirectional, 0, '']

--- rnn_cell[input_size, hidden_size, bias, nonlinearity], lstm_cell,
--- gru_cell: one step (nn.RNNCell, nn.LSTMCell, nn.GRUCell), its
--- parameters weight_ih, weight_hh, bias_ih and bias_hh, each drawn within
--- ±1/√hidden
fn rnn_cell[input_size, hidden_size, bias = true, nonlinearity = 'tanh']
    if nonlinearity ne 'tanh' and nonlinearity ne 'relu'
        halt['Unknown nonlinearity: `nonlinearity`']
    return _cell_layer['rnn_cell', input_size, hidden_size, bias, nonlinearity]

fn lstm_cell[input_size, hidden_size, bias = true]
    return _cell_layer['lstm_cell', input_size, hidden_size, bias, '']

fn gru_cell[input_size, hidden_size, bias = true]
    return _cell_layer['gru_cell', input_size, hidden_size, bias, '']

--- how many gates a recurrent form's weights stack
fn _gate_count[form]
    if form eq 'lstm' or form eq 'lstm_cell'
        return 4
    if form eq 'gru' or form eq 'gru_cell'
        return 3
    return 1

fn _recurrent_layer[form, ins, hidden, layers, bias, batch_first, dropout, bidirectional, proj, word]
    if hidden lt 1
        halt['hidden_size must be greater than zero']
    if layers lt 1
        halt['num_layers must be greater than zero']
    if dropout lt 0.0 or dropout gt 1.0
        halt['dropout should be a number in range [0, 1] representing the probability of an element being zeroed']
    gates = _gate_count[form]
    dirs = 1
    if bidirectional
        dirs = 2
    hout = hidden
    if proj gt 0
        hout = proj
    own = 0
    for l in range[layers]
        width = ins
        if l gt 0
            width = dirs * hout
        per = gates * hidden * width + gates * hidden * hout
        if bias
            per = per + 2 * gates * hidden
        if proj gt 0
            per = per + proj * hidden
        own = own + dirs * per
    return _leaf[form, own, [ins, hidden, layers, proj, dirs], [float[dropout]], word, [bias, batch_first, bidirectional]]

fn _cell_layer[form, ins, hidden, bias, word]
    gates = _gate_count[form]
    own = gates * hidden * (ins + hidden)
    if bias
        own = own + 2 * gates * hidden
    return _leaf[form, own, [ins, hidden, 1, 0, 1], [0.0], word, [bias, false, false]]

--- the activations, each nn.functional's function as a layer
fn relu[]
    return _plain['relu', [0], [0.0], '']

fn relu6[]
    return _plain['relu6', [0], [0.0], '']

fn elu[alpha = 1.0]
    return _plain['elu', [0], [alpha], '']

fn selu[]
    return _plain['selu', [0], [0.0], '']

fn celu[alpha = 1.0]
    return _plain['celu', [0], [alpha], '']

fn gelu[approximate = 'none']
    return _plain['gelu', [0], [0.0], approximate]

fn sigmoid[]
    return _plain['sigmoid', [0], [0.0], '']

fn silu[]
    return _plain['silu', [0], [0.0], '']

fn mish[]
    return _plain['mish', [0], [0.0], '']

fn tanh[]
    return _plain['tanh', [0], [0.0], '']

fn softsign[]
    return _plain['softsign', [0], [0.0], '']

fn softplus[beta = 1.0, limit = 20.0]
    return _plain['softplus', [0], [beta, limit], '']

fn logsigmoid[]
    return _plain['logsigmoid', [0], [0.0], '']

fn tanhshrink[]
    return _plain['tanhshrink', [0], [0.0], '']

fn softshrink[lambd = 0.5]
    return _plain['softshrink', [0], [lambd], '']

fn hardshrink[lambd = 0.5]
    return _plain['hardshrink', [0], [lambd], '']

fn hardtanh[lo = -1.0, hi = 1.0]
    return _plain['hardtanh', [0], [lo, hi], '']

fn hardsigmoid[]
    return _plain['hardsigmoid', [0], [0.0], '']

fn hardswish[]
    return _plain['hardswish', [0], [0.0], '']

fn leaky_relu[slope = 0.01]
    return _plain['leaky_relu', [0], [slope], '']

fn threshold[limit, value]
    return _plain['threshold', [0], [limit, value], '']

fn glu[dim = -1]
    return _plain['glu', [dim], [0.0], '']

fn softmax[dim = -1]
    return _plain['softmax', [dim], [0.0], '']

fn log_softmax[dim = -1]
    return _plain['log_softmax', [dim], [0.0], '']

fn softmin[dim = -1]
    return _plain['softmin', [dim], [0.0], '']

--- the containers -----------------------------------------------------------

--- a layer of parts placed after its own parameters, each part's at its
--- offset in theta, recursively
fn _placed[layer, at]
    out = layer
    out.at = at
    next = at + layer.own
    kids = []
    for p in layer.parts
        kids = push[kids, _placed[p, next]]
        next = next + p.size
    out.parts = kids
    return out

fn _container[form, parts]
    total = 0
    for p in parts
        total = total + p.size
    return _placed[Layer[form, '', 0, 0, total, _sizes[[0]], _reals[[0.0]], '', [false], true, m.zeros[0], parts], 0]

--- sequential[parts]: each part run on what the one before answered, the
--- parts named 0, 1, … (nn.Sequential)
fn sequential[parts]
    ordered = []
    for i in range[len[parts]]
        q = parts[i]
        q.name = str[i]
        ordered = push[ordered, q]
    return _container['sequential', ordered]

--- module[parts]: parts by name, a map of layers, for a forward function
--- the program writes (nn.Module's attributes): nn.part finds each. The
--- parts are laid, and drawn, in the order of their names (a map's keys),
--- where PyTorch's are in the order its constructor made them: a module
--- whose parts' names sort in the order PyTorch's are made starts from
--- PyTorch's numbers
fn module[parts]
    ordered = []
    for k in keys[parts]
        q = parts[k]
        q.name = k
        ordered = push[ordered, q]
    return _container['module', ordered]

--- part[model, name]: the part of that name
fn part[model, name]
    for p in model.parts
        if p.name eq name
            return p
    halt['no part named `name`']

--- size[model]: how many parameters the model holds
fn size[model]
    return model.size

--- running a model -----------------------------------------------------------

--- a slice of theta: n numbers from `at`
fn _numbers[theta, at, n]
    return slice[theta, at, at + n]

--- forward[layer, theta, x]: the layer run on x, its parameters read from
--- theta. Between layers the numbers go flat, their sizes beside them
--- (`_run`, `_after`): a model's layers change the rank of what they hand
--- on — a flatten, an embedding — and one copy of a function holds one
--- rank, so each layer lays the numbers in the rank it computes at, as
--- PyTorch's kernels view a tensor's storage
fn forward[layer, theta, x]
    dims = x.shape
    return shapes.laid[_run[layer, theta, m.flatten[x], dims], _after[layer, dims]]

--- a layer run on the flat numbers `v` of a tensor of sizes `dims`: its
--- answer's numbers, flat (their sizes are `_after`'s)
fn _run[layer, theta, v, dims]
    f = layer.form
    at = layer.at
    if f eq 'sequential'
        h = v
        d = dims
        for p in layer.parts
            h = _run[p, theta, h, d]
            d = _after[p, d]
        return h
    if f eq 'module'
        halt['a model made by nn.module runs by a forward function the program writes, which runs its parts (nn.part)']
    if f eq 'linear'
        ins = layer.ints[0]
        outs = layer.ints[1]
        w = m.reshape[_numbers[theta, at, outs * ins], outs, ins]
        x = m.reshape[v, len[v] / ins, ins]
        if layer.flags[0]
            return m.flatten[functional.linear[x, w, _numbers[theta, at + outs * ins, outs]]]
        return m.flatten[functional.linear[x, w]]
    if f eq 'embedding'
        count = layer.ints[0]
        dim = layer.ints[1]
        return m.flatten[functional.embedding[v, m.reshape[_numbers[theta, at, count * dim], count, dim]]]
    if f eq 'layer_norm' or f eq 'rms_norm'
        n = shapes.product[layer.ints]
        eps = layer.floats[0]
        x = m.reshape[v, len[v] / n, n]
        if f eq 'rms_norm'
            if not layer.flags[0]
                return m.flatten[functional.rms_norm[x, [n], 1.0, eps]]
            return m.flatten[functional.rms_norm[x, [n], _numbers[theta, at, n], eps]]
        if not layer.flags[0]
            return m.flatten[functional.layer_norm[x, [n], 1.0, 0.0, eps]]
        if not layer.flags[1]
            return m.flatten[functional.layer_norm[x, [n], _numbers[theta, at, n], 0.0, eps]]
        return m.flatten[functional.layer_norm[x, [n], _numbers[theta, at, n], _numbers[theta, at + n, n], eps]]
    if f eq 'batch_norm'
        c = layer.ints[0]
        eps = layer.floats[0]
        momentum = layer.floats[1]
        batch = layer.training or not layer.flags[1]
        mean_run = slice[layer.held, 0, c]
        var_run = slice[layer.held, c, 2 * c]
        x = _channeled[v, dims]
        if not layer.flags[0]
            return m.flatten[functional.batch_norm[x, mean_run, var_run, 1.0, 0.0, batch, momentum, eps]]
        return m.flatten[functional.batch_norm[x, mean_run, var_run, _numbers[theta, at, c], _numbers[theta, at + c, c], batch, momentum, eps]]
    if f eq 'group_norm'
        groups = layer.ints[0]
        c = layer.ints[1]
        eps = layer.floats[0]
        x = _channeled[v, dims]
        if not layer.flags[0]
            return m.flatten[functional.group_norm[x, groups, 1.0, 0.0, eps]]
        return m.flatten[functional.group_norm[x, groups, _numbers[theta, at, c], _numbers[theta, at + c, c], eps]]
    if f eq 'instance_norm'
        c = layer.ints[0]
        eps = layer.floats[0]
        x = _channeled[v, dims]
        if not layer.flags[0]
            return m.flatten[functional.instance_norm[x, 1.0, 0.0, eps]]
        return m.flatten[functional.instance_norm[x, _numbers[theta, at, c], _numbers[theta, at + c, c], eps]]
    if f eq 'prelu'
        w = _numbers[theta, at, layer.ints[0]]
        if layer.ints[0] eq 1 or len[dims] lt 2
            return functional.prelu[v, w]
        return m.flatten[functional.prelu[_channeled[v, dims], w]]
    if f eq 'dropout'
        return functional.dropout[v, layer.floats[0], layer.training]
    if f eq 'identity' or f eq 'flatten' or f eq 'unflatten'
        return v
    if f eq 'conv' or f eq 'conv_transpose'
        return _windowed[layer, theta, v, dims]
    if f eq 'max_pool' or f eq 'avg_pool' or f eq 'lp_pool' or f eq 'adaptive_avg_pool' or f eq 'adaptive_max_pool'
        return _pooled[layer, v, dims]
    if f eq 'pad'
        return m.flatten[functional.pad[shapes.laid[v, dims], layer.ints, layer.word, layer.floats[0]]]
    if f eq 'upsample'
        return m.flatten[_upsampled[layer, shapes.laid[v, dims]]]
    if f eq 'pixel_shuffle'
        return m.flatten[functional.pixel_shuffle[shapes.laid[v, dims], layer.ints[0]]]
    if f eq 'pixel_unshuffle'
        return m.flatten[functional.pixel_unshuffle[shapes.laid[v, dims], layer.ints[0]]]
    if f eq 'channel_shuffle'
        return m.flatten[functional.channel_shuffle[shapes.laid[v, dims], layer.ints[0]]]
    if f eq 'dropout_channels'
        x = shapes.laid[v, dims]
        if layer.ints[0] eq 1
            return m.flatten[functional.dropout1d[x, layer.floats[0], layer.training]]
        if layer.ints[0] eq 2
            return m.flatten[functional.dropout2d[x, layer.floats[0], layer.training]]
        return m.flatten[functional.dropout3d[x, layer.floats[0], layer.training]]
    if f eq 'rnn' or f eq 'lstm' or f eq 'gru' or f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
        return _recurrence[layer, theta, v, dims, 0.0, 0.0].output
    if f eq 'glu' or f eq 'softmax' or f eq 'log_softmax' or f eq 'softmin'
        x = _around[v, dims, layer.ints[0]]
        if f eq 'glu'
            return m.flatten[functional.glu[x, 1]]
        if f eq 'softmax'
            return m.flatten[functional.softmax[x, 1]]
        if f eq 'log_softmax'
            return m.flatten[functional.log_softmax[x, 1]]
        return m.flatten[functional.softmin[x, 1]]
    return _activated[layer, v]

--- the sizes a layer answers, given the sizes of what it runs on
fn _after[layer, dims]
    f = layer.form
    if f eq 'sequential'
        d = dims
        for p in layer.parts
            d = _after[p, d]
        return d
    if f eq 'linear'
        return shapes.with_size[dims, len[dims] - 1, layer.ints[1]]
    if f eq 'embedding'
        return push[dims, layer.ints[1]]
    if f eq 'flatten'
        a = shapes.axis_of[dims, layer.ints[0]]
        b = shapes.axis_of[dims, layer.ints[1]]
        out = slice[dims, 0, a]
        out = push[out, shapes.product[slice[dims, a, b + 1]]]
        for d in slice[dims, b + 1, len[dims]]
            out = push[out, d]
        return out
    if f eq 'glu'
        a = shapes.axis_of[dims, layer.ints[0]]
        return shapes.with_size[dims, a, dims[a] / 2]
    if f eq 'unflatten'
        a = shapes.axis_of[dims, layer.ints[0]]
        sizes = slice[layer.ints, 1, len[layer.ints]]
        known = 1
        for d in sizes
            if d ne -1
                known = known * d
        out = slice[dims, 0, a]
        for d in sizes
            if d eq -1
                out = push[out, dims[a] / known]
            else
                out = push[out, d]
        if shapes.product[slice[out, a, len[out]]] ne dims[a]
            halt['unflatten: the sizes `str[sizes]` do not hold the `dims[a]` numbers of axis `a`']
        for d in slice[dims, a + 1, len[dims]]
            out = push[out, d]
        return out
    if f eq 'conv' or f eq 'conv_transpose'
        d = layer.ints[0]
        given = windows.batch_of[dims, d, f]
        if f eq 'conv'
            at = windows.outs[given.sizes, _part[layer, 0], _part[layer, 1], windows.Pads[_part[layer, 2], _part[layer, 3]], _part[layer, 4], f]
            return windows.batch_dims[given, layer.ints[2], at]
        return windows.batch_dims[given, layer.ints[2], functional.transposed_sizes[given.sizes, _part[layer, 0], _part[layer, 1], _part[layer, 2], _part[layer, 3], _part[layer, 4], f]]
    if f eq 'max_pool' or f eq 'avg_pool' or f eq 'lp_pool'
        d = layer.ints[0]
        given = windows.planes_of[dims, d, f]
        pads = windows.each[0, d, f]
        if f ne 'lp_pool'
            pads = _part[layer, 2]
        dl = windows.each[1, d, f]
        if f eq 'max_pool'
            dl = _part[layer, 3]
        return concat[given.lead, functional.pooled_sizes[given.sizes, _part[layer, 0], _part[layer, 1], pads, dl, layer.flags[0], f]]
    if f eq 'adaptive_avg_pool' or f eq 'adaptive_max_pool'
        given = windows.planes_of[dims, layer.ints[0], f]
        return concat[given.lead, _part[layer, 0]]
    if f eq 'pad'
        return windows.padded_dims[dims, layer.ints]
    if f eq 'upsample'
        k = layer.ints[0]
        sizes = slice[dims, 2, len[dims]]
        if k gt 0
            return concat[slice[dims, 0, 2], windows.each[slice[layer.ints, 1, 1 + k], len[sizes], 'size']]
        out = slice[dims, 0, 2]
        for j in range[len[sizes]]
            s = layer.floats[0]
            if len[layer.floats] eq len[sizes]
                s = layer.floats[j]
            out = push[out, int[floor[float[sizes[j]] * s]]]
        return out
    if f eq 'pixel_shuffle'
        k = len[dims]
        r = layer.ints[0]
        return concat[slice[dims, 0, k - 3], [dims[k - 3] / (r * r), dims[k - 2] * r, dims[k - 1] * r]]
    if f eq 'pixel_unshuffle'
        k = len[dims]
        r = layer.ints[0]
        return concat[slice[dims, 0, k - 3], [dims[k - 3] * r * r, dims[k - 2] / r, dims[k - 1] / r]]
    if f eq 'rnn' or f eq 'lstm' or f eq 'gru'
        hout = layer.ints[1]
        if layer.ints[3] gt 0
            hout = layer.ints[3]
        return shapes.with_size[dims, len[dims] - 1, layer.ints[4] * hout]
    if f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
        return shapes.with_size[dims, len[dims] - 1, layer.ints[1]]
    return dims

--- flat numbers of sizes `dims` `[N, C, …]` laid `[N, C, M]`, M a
--- channel's numbers in one item (an input `[N, C]` is `[N, C, 1]`)
fn _channeled[v, dims]
    if len[dims] lt 2
        halt['a layer over channels takes N, C and more axes, and this has `len[dims]`']
    return m.reshape[v, dims[0], dims[1], len[v] / (dims[0] * dims[1])]

--- flat numbers of sizes `dims` laid `[before, size, after]` around the
--- axis `dim` names: a function along one axis computes there as along it
fn _around[v, dims, dim]
    a = shapes.axis_of[dims, dim]
    before = shapes.product[slice[dims, 0, a]]
    after = shapes.product[slice[dims, a + 1, len[dims]]]
    return m.reshape[v, before, dims[a], after]

--- an activation layer run on x
--- a convolution layer run on flat numbers: its weight and bias read from
--- theta, the input padded by its padding_mode first where that is not
--- zeros (then convolved with no padding, as PyTorch's layer does)
fn _windowed[layer, theta, v, dims]
    f = layer.form
    d = layer.ints[0]
    ins = layer.ints[1]
    outs = layer.ints[2]
    groups = layer.ints[3]
    kernel = _part[layer, 0]
    stride = _part[layer, 1]
    taps = shapes.product[kernel]
    given = windows.batch_of[dims, d, f]
    if given.channels ne ins
        halt['`f`: expected input with `ins` channels, but got `given.channels` channels instead']
    count = outs * (ins / groups) * taps
    if f eq 'conv_transpose'
        count = ins * (outs / groups) * taps
    wv = _numbers[theta, layer.at, count]
    b = m.zeros[outs]
    if layer.flags[0]
        b = _numbers[theta, layer.at + count, outs]
    if f eq 'conv_transpose'
        return functional.conv_transpose_flat[v, given.n, ins, given.sizes, wv, outs, kernel, b, stride, _part[layer, 2], _part[layer, 3], _part[layer, 4], groups, f]
    pads = windows.Pads[_part[layer, 2], _part[layer, 3]]
    dilation = _part[layer, 4]
    if layer.word eq 'zeros'
        return functional.conv_flat[v, given.n, ins, given.sizes, wv, outs, kernel, b, stride, pads, dilation, groups, f]
    widths = []
    for j in range[d]
        a = d - 1 - j
        widths = push[push[widths, pads.low[a]], pads.high[a]]
    padded = windows.padded_dims[dims, widths]
    x = m.flatten[concat[v, m.zeros[1]][windows.padded[dims, widths, layer.word, f]]]
    none = windows.each[0, d, f]
    return functional.conv_flat[x, given.n, ins, slice[padded, len[padded] - d, len[padded]], wv, outs, kernel, b, stride, windows.Pads[none, none], dilation, groups, f]

--- a pooling layer run on flat numbers, plane by plane
fn _pooled[layer, v, dims]
    f = layer.form
    d = layer.ints[0]
    given = windows.planes_of[dims, d, f]
    if f eq 'adaptive_avg_pool'
        return functional.adaptive_flat[v, given.count, given.sizes, _part[layer, 0], 'avg']
    if f eq 'adaptive_max_pool'
        return functional.adaptive_flat[v, given.count, given.sizes, _part[layer, 0], 'max']
    kernel = _part[layer, 0]
    stride = _part[layer, 1]
    if f eq 'lp_pool'
        return functional.lp_pool_flat[v, given.count, given.sizes, layer.floats[0], kernel, stride, layer.flags[0], f]
    if f eq 'max_pool'
        return functional.max_pool_flat[v, given.count, given.sizes, kernel, stride, _part[layer, 2], _part[layer, 3], layer.flags[0], f]
    return functional.avg_pool_flat[v, given.count, given.sizes, kernel, stride, _part[layer, 2], layer.flags[0], layer.flags[1], layer.ints[1], f]

--- an upsampling layer run on x: F.interpolate by its size or its scale
fn _upsampled[layer, x]
    k = layer.ints[0]
    if k gt 0
        return functional.interpolate[x, slice[layer.ints, 1, 1 + k], 0.0, layer.word, layer.flags[0]]
    return functional.interpolate[x, 0, layer.floats, layer.word, layer.flags[0]]

--- a parameter's numbers as the matrix its sizes say
fn _matrix[theta, p]
    return m.reshape[_numbers[theta, p.at, p.dims[0] * p.dims[1]], p.dims[0], p.dims[1]]

--- vectors joined, one after another
fn _joined[pieces]
    out = m.zeros[0]
    for p in pieces
        out = concat[out, p]
    return out

--- a recurrent layer run on the flat numbers `v` of x `dims` from the
--- states h0 and c0 (flat, or a number every state starts at): its
--- output, its last hidden states and, for an LSTM, its last cell states,
--- each flat (`Recurrent`). PyTorch's order throughout: each layer's
--- inputs projected for every step at once (x · w_ihᵀ + b_ih), then each
--- step's gates the hidden state's projection plus the input's; a layer
--- both ways runs a second time from the last step back, its outputs beside
--- the first's; dropout between layers in training
fn _recurrence[layer, theta, v, dims, h0, c0]
    f = layer.form
    ins = layer.ints[0]
    hidden = layer.ints[1]
    layers = layer.ints[2]
    proj = layer.ints[3]
    dirs = layer.ints[4]
    bias = layer.flags[0]
    gates = _gate_count[f]
    hout = hidden
    if proj gt 0
        hout = proj
    cell = f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
    rank = len[dims]
    if rank eq 0 or dims[rank - 1] ne ins
        halt['`f`: input.size(-1) must be equal to input_size. Expected `ins`, got `str[dims]`']
    steps = 1
    n = 1
    batched = false
    if cell
        if rank ne 1 and rank ne 2
            halt['`f`: Expected input to be 1D or 2D, got `rank`D instead']
        batched = rank eq 2
        if batched
            n = dims[0]
    else
        if rank ne 2 and rank ne 3
            halt['`f`: input must have 2 dimensions (unbatched) or 3, got `rank`']
        batched = rank eq 3
        steps = dims[0]
        if batched
            n = dims[1]
            if layer.flags[1]
                steps = dims[1]
                n = dims[0]
    if steps lt 1
        halt['`f`: Expected sequence length to be larger than 0 in RNN']
    x = v
    if batched and layer.flags[1] and not cell
        x = m.flatten[v[windows.swapped[n, steps, ins]]]
    seq = m.reshape[x, steps * n, ins]
    hs = m.zeros[dirs * layers * n * hout] + m.flatten[m.zeros[1] + h0]
    cs = m.zeros[dirs * layers * n * hidden] + m.flatten[m.zeros[1] + c0]
    names = _recurrent_named[layer, '']
    per = 2
    if bias
        per = 4
    if proj gt 0
        per = per + 1
    last_h = []
    last_c = []
    for l in range[layers]
        made = []
        for dir in range[dirs]
            k = l * dirs + dir
            base = k * per
            w_ih = _matrix[theta, names[base]]
            w_hh = _matrix[theta, names[base + 1]]
            b_ih = m.zeros[gates * hidden]
            b_hh = m.zeros[gates * hidden]
            if bias
                b_ih = _numbers[theta, names[base + 2].at, gates * hidden]
                b_hh = _numbers[theta, names[base + 3].at, gates * hidden]
            ig = functional.linear[seq, w_ih, b_ih]
            h = m.reshape[slice[hs, k * n * hout, (k + 1) * n * hout], n, hout]
            c = m.reshape[slice[cs, k * n * hidden, (k + 1) * n * hidden], n, hidden]
            walked = []
            for j in range[steps]
                t = j
                if dir eq 1
                    t = steps - 1 - j
                gi = slice[ig, t * n, (t + 1) * n]
                gh = functional.linear[h, w_hh, b_hh]
                if f eq 'lstm' or f eq 'lstm_cell'
                    s = functional.lstm_step[gh + gi, c]
                    c = s.c
                    h = s.h
                    if proj gt 0
                        h = h * transpose[_matrix[theta, names[base + per - 1]]]
                else
                    if f eq 'gru' or f eq 'gru_cell'
                        h = functional.gru_step[gi, gh, h]
                    else
                        if layer.word eq 'relu'
                            h = functional.relu[m.reshape[gh + gi, n, hidden]]
                        else
                            h = m.tanh[gh + gi]
                walked = push[walked, m.flatten[h]]
            ordered = m.zeros[0]
            for j in range[steps]
                q = j
                if dir eq 1
                    q = steps - 1 - j
                ordered = concat[ordered, walked[q]]
            made = push[made, m.reshape[ordered, steps * n, hout]]
            last_h = push[last_h, m.flatten[h]]
            last_c = push[last_c, m.flatten[c]]
        seq = made[0]
        if dirs eq 2
            seq = concat[made[0], made[1], axis = 1]
        if layer.training and layer.floats[0] gt 0.0 and l lt layers - 1
            seq = functional.dropout[seq, layer.floats[0], true]
    out = m.flatten[seq]
    if batched and layer.flags[1] and not cell
        out = m.flatten[out[windows.swapped[steps, n, dirs * hout]]]
    cells = m.zeros[0]
    if f eq 'lstm' or f eq 'lstm_cell'
        cells = _joined[last_c]
    return Recurrent[out, _joined[last_h], cells]

--- recurrent[layer, theta, x, h0, c0]: a recurrent layer run on x from
--- the hidden states h0 and, for an LSTM, the cell states c0 — zeros where
--- not given, as PyTorch's — answering its output, its last hidden states
--- h_n and its last cell states c_n, laid as PyTorch lays them
--- (`Recurrent`): `output, (h_n, c_n) = lstm(x, (h0, c0))`; h0 and h_n
--- `[layers·directions, batch, hidden]` (no batch axis for an input of none);
--- a cell's output and h_n its new hidden state `[batch, hidden]`, its c the
--- new cell state. c holds no numbers for an RNN or a GRU
fn recurrent[layer, theta, x, h0 = 0.0, c0 = 0.0]
    f = layer.form
    if not (f eq 'rnn' or f eq 'lstm' or f eq 'gru' or f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell')
        halt['nn.recurrent runs a recurrent layer (rnn, lstm, gru and their cells), and was given `f`']
    dims = x.shape
    hout = layer.ints[1]
    if layer.ints[3] gt 0
        hout = layer.ints[3]
    hdims = _state_dims[layer, dims, hout]
    cdims = _state_dims[layer, dims, layer.ints[1]]
    given = (m.zeros[1] + h0).shape
    if not (given eq [1] or given eq hdims)
        halt['`f`: Expected hidden size `str[hdims]`, got `str[given]`']
    held = (m.zeros[1] + c0).shape
    if not (held eq [1] or held eq cdims)
        halt['`f`: Expected hidden size `str[cdims]`, got `str[held]`']
    r = _recurrence[layer, theta, m.flatten[x], dims, h0, c0]
    if f eq 'lstm' or f eq 'lstm_cell'
        return Recurrent[shapes.laid[r.output, _after[layer, dims]], shapes.laid[r.h, hdims], shapes.laid[r.c, cdims]]
    return Recurrent[shapes.laid[r.output, _after[layer, dims]], shapes.laid[r.h, hdims], r.c]

--- the sizes of a recurrent layer's states for an input `dims`, `size`
--- numbers each
fn _state_dims[layer, dims, size]
    f = layer.form
    cell = f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
    out = []
    if not cell
        out = [layer.ints[4] * layer.ints[2]]
    if (cell and len[dims] eq 2) or ((not cell) and len[dims] eq 3)
        n = dims[0]
        if (not cell) and (not layer.flags[1])
            n = dims[1]
        out = push[out, n]
    return push[out, size]

fn _activated[layer, x]
    f = layer.form
    v = layer.floats
    if f eq 'relu'
        return functional.relu[x]
    if f eq 'relu6'
        return functional.relu6[x]
    if f eq 'elu'
        return functional.elu[x, v[0]]
    if f eq 'selu'
        return functional.selu[x]
    if f eq 'celu'
        return functional.celu[x, v[0]]
    if f eq 'gelu'
        return functional.gelu[x, layer.word]
    if f eq 'sigmoid'
        return functional.sigmoid[x]
    if f eq 'silu'
        return functional.silu[x]
    if f eq 'mish'
        return functional.mish[x]
    if f eq 'tanh'
        return m.tanh[x]
    if f eq 'softsign'
        return functional.softsign[x]
    if f eq 'softplus'
        return functional.softplus[x, v[0], v[1]]
    if f eq 'logsigmoid'
        return functional.logsigmoid[x]
    if f eq 'tanhshrink'
        return functional.tanhshrink[x]
    if f eq 'softshrink'
        return functional.softshrink[x, v[0]]
    if f eq 'hardshrink'
        return functional.hardshrink[x, v[0]]
    if f eq 'hardtanh'
        return functional.hardtanh[x, v[0], v[1]]
    if f eq 'hardsigmoid'
        return functional.hardsigmoid[x]
    if f eq 'hardswish'
        return functional.hardswish[x]
    if f eq 'leaky_relu'
        return functional.leaky_relu[x, v[0]]
    if f eq 'threshold'
        return functional.threshold[x, v[0], v[1]]
    if f eq 'glu'
        return functional.glu[x, layer.ints[0]]
    if f eq 'softmax'
        return functional.softmax[x, layer.ints[0]]
    if f eq 'log_softmax'
        return functional.log_softmax[x, layer.ints[0]]
    if f eq 'softmin'
        return functional.softmin[x, layer.ints[0]]
    halt['nn.forward: no layer of the form `f`']

--- forward2[layer, theta, x1, x2]: a layer of two inputs run on them
--- (nn.Bilinear)
fn forward2[layer, theta, x1, x2]
    if layer.form ne 'bilinear'
        halt['nn.forward2 runs a layer of two inputs (bilinear), and this is `layer.form`']
    in1 = layer.ints[0]
    in2 = layer.ints[1]
    outs = layer.ints[2]
    at = layer.at
    n = outs * in1 * in2
    w = m.reshape[_numbers[theta, at, n], outs, in1, in2]
    if layer.flags[0]
        return functional.bilinear[x1, x2, w, _numbers[theta, at + n, outs]]
    return functional.bilinear[x1, x2, w]

--- param[model, theta, path]: a parameter by its name in the model's
--- state (`weight`, `0.bias`), laid as PyTorch lays it
fn param[model, theta, path]
    for p in named[model]
        if p.path eq path
            return shapes.laid[m.flatten[_numbers[theta, p.at, shapes.product[p.dims]]], p.dims]
    halt['no parameter `path` in a `model.form` layer']

--- with_param[model, theta, path, value]: theta with the parameter of that
--- name given value's numbers (an nn.init tensor, a trained one), the
--- rest as they are
fn with_param[model, theta, path, value]
    for p in named[model]
        if p.path eq path
            n = shapes.product[p.dims]
            given = m.flatten[value]
            if len[given] ne n
                halt['`path` holds `n` numbers, and the value given has `len[given]`']
            return concat[concat[slice[theta, 0, p.at], given], slice[theta, p.at + n, len[theta]]]
    halt['no parameter `path` in a `model.form` layer']

--- the parameters --------------------------------------------------------------

--- parameters[model, g]: theta, each parameter drawn from the generator g
--- as PyTorch's module draws it by default when it is made (in float64,
--- torch.set_default_dtype(torch.float64)), the layers in order: a linear
--- layer's weight kaiming_uniform with a = √5 (within ±1/√ins, by
--- PyTorch's own arithmetic of the bound), then its bias uniform within
--- ±1/√ins; a bilinear's both within ±1/√in1; an embedding's normal; a
--- normalization's weight 1 and bias 0; a prelu's its init. It answers
--- theta beside g past the draws (`rng.Floats`)
fn parameters[model, g]
    own = _own_drawn[model, g]
    out = own.values
    at = own.generator
    for p in model.parts
        d = parameters[p, at]
        out = concat[out, d.values]
        at = d.generator
    --- (a vector, said so: the parts' answers come from this function
    --- itself, which no rank is known of until it is typed)
    return rng.Floats[m.flatten[out], at]

--- the kaiming_uniform bound PyTorch's linear and convolution layers
--- start their weights within: √3 · gain / √fan_in, the gain a leaky
--- relu's of slope √5, in PyTorch's order of operations
fn _kaiming_bound[fan_in]
    a = sqrt[5.0]
    gain = sqrt[2.0 / (1.0 + a * a)]
    return sqrt[3.0] * (gain / sqrt[float[fan_in]])

fn _own_drawn[layer, g]
    f = layer.form
    if f eq 'linear'
        ins = layer.ints[0]
        outs = layer.ints[1]
        bound = _kaiming_bound[ins]
        w = rng.uniform[g, outs * ins, -bound, bound]
        if layer.flags[0]
            b = 1.0 / sqrt[float[ins]]
            bias = rng.uniform[w.generator, outs, -b, b]
            return rng.Floats[concat[w.values, bias.values], bias.generator]
        return w
    if f eq 'bilinear'
        in1 = layer.ints[0]
        in2 = layer.ints[1]
        outs = layer.ints[2]
        bound = 1.0 / sqrt[float[in1]]
        w = rng.uniform[g, outs * in1 * in2, -bound, bound]
        if layer.flags[0]
            bias = rng.uniform[w.generator, outs, -bound, bound]
            return rng.Floats[concat[w.values, bias.values], bias.generator]
        return w
    if f eq 'embedding'
        return rng.normal[g, layer.own]
    if f eq 'conv' or f eq 'conv_transpose'
        ins = layer.ints[1]
        outs = layer.ints[2]
        groups = layer.ints[3]
        taps = shapes.product[_part[layer, 0]]
        fan_in = (ins / groups) * taps
        count = outs * fan_in
        if f eq 'conv_transpose'
            fan_in = (outs / groups) * taps
            count = ins * fan_in
        bound = _kaiming_bound[fan_in]
        w = rng.uniform[g, count, -bound, bound]
        if layer.flags[0]
            b = 1.0 / sqrt[float[fan_in]]
            bias = rng.uniform[w.generator, outs, -b, b]
            return rng.Floats[concat[w.values, bias.values], bias.generator]
        return w
    if f eq 'rnn' or f eq 'lstm' or f eq 'gru' or f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
        stdv = 1.0 / sqrt[float[layer.ints[1]]]
        return rng.uniform[g, layer.own, -stdv, stdv]
    return rng.Floats[_own_fixed[layer], g]

--- a layer's own parameters that no draw makes
fn _own_fixed[layer]
    f = layer.form
    if f eq 'layer_norm'
        n = shapes.product[layer.ints]
        if layer.own eq 2 * n
            return concat[m.ones[n], m.zeros[n]]
        return m.ones[layer.own]
    if f eq 'rms_norm'
        return m.ones[layer.own]
    if f eq 'batch_norm' or f eq 'group_norm' or f eq 'instance_norm'
        half = layer.own / 2
        return concat[m.ones[half], m.zeros[half]]
    if f eq 'prelu'
        return m.zeros[layer.own] + layer.floats[0]
    return m.zeros[0]

--- named[model]: every parameter's name, place and sizes, in theta's
--- order (PyTorch's named_parameters)
fn named[model]
    return _named_in[model, '']

fn _named_in[layer, prefix]
    out = _own_named[layer, prefix]
    for p in layer.parts
        for q in _named_in[p, join[[prefix, p.name, '.'], '']]
            out = push[out, q]
    return out

fn _own_named[layer, prefix]
    f = layer.form
    at = layer.at
    if f eq 'linear'
        ins = layer.ints[0]
        outs = layer.ints[1]
        out = [Named['`prefix`weight', at, [outs, ins]]]
        if layer.flags[0]
            out = push[out, Named['`prefix`bias', at + outs * ins, [outs]]]
        return out
    if f eq 'bilinear'
        in1 = layer.ints[0]
        in2 = layer.ints[1]
        outs = layer.ints[2]
        out = [Named['`prefix`weight', at, [outs, in1, in2]]]
        if layer.flags[0]
            out = push[out, Named['`prefix`bias', at + outs * in1 * in2, [outs]]]
        return out
    if f eq 'embedding'
        return [Named['`prefix`weight', at, layer.ints]]
    if f eq 'layer_norm' or f eq 'rms_norm'
        n = shapes.product[layer.ints]
        out = []
        if layer.own gt 0
            out = push[out, Named['`prefix`weight', at, layer.ints]]
        if layer.own eq 2 * n
            out = push[out, Named['`prefix`bias', at + n, layer.ints]]
        return out
    if f eq 'batch_norm' or f eq 'group_norm' or f eq 'instance_norm'
        half = layer.own / 2
        out = []
        if half gt 0
            out = push[out, Named['`prefix`weight', at, [half]]]
            out = push[out, Named['`prefix`bias', at + half, [half]]]
        return out
    if f eq 'prelu'
        return [Named['`prefix`weight', at, layer.ints]]
    if f eq 'conv' or f eq 'conv_transpose'
        ins = layer.ints[1]
        outs = layer.ints[2]
        groups = layer.ints[3]
        dims = concat[[outs, ins / groups], _part[layer, 0]]
        if f eq 'conv_transpose'
            dims = concat[[ins, outs / groups], _part[layer, 0]]
        out = [Named['`prefix`weight', at, dims]]
        if layer.flags[0]
            out = push[out, Named['`prefix`bias', at + shapes.product[dims], [outs]]]
        return out
    if f eq 'rnn' or f eq 'lstm' or f eq 'gru' or f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
        return _recurrent_named[layer, prefix]
    return []

--- a recurrent layer's parameters, named and laid as PyTorch's: for each
--- layer and direction weight_ih, weight_hh, bias_ih, bias_hh and an LSTM's
--- projection weight_hr, suffixed `_l0`, `_l0_reverse`, … (a cell's bare)
fn _recurrent_named[layer, prefix]
    f = layer.form
    ins = layer.ints[0]
    hidden = layer.ints[1]
    proj = layer.ints[3]
    dirs = layer.ints[4]
    gates = _gate_count[f]
    hout = hidden
    if proj gt 0
        hout = proj
    cell = f eq 'rnn_cell' or f eq 'lstm_cell' or f eq 'gru_cell'
    out = []
    at = layer.at
    for l in range[layer.ints[2]]
        width = ins
        if l gt 0
            width = dirs * hout
        for dir in range[dirs]
            tail = '_l`l`'
            if dir eq 1
                tail = '_l`l`_reverse'
            if cell
                tail = ''
            out = push[out, Named['`prefix`weight_ih`tail`', at, [gates * hidden, width]]]
            at = at + gates * hidden * width
            out = push[out, Named['`prefix`weight_hh`tail`', at, [gates * hidden, hout]]]
            at = at + gates * hidden * hout
            if layer.flags[0]
                out = push[out, Named['`prefix`bias_ih`tail`', at, [gates * hidden]]]
                at = at + gates * hidden
                out = push[out, Named['`prefix`bias_hh`tail`', at, [gates * hidden]]]
                at = at + gates * hidden
            if proj gt 0
                out = push[out, Named['`prefix`weight_hr`tail`', at, [proj, hidden]]]
                at = at + proj * hidden
    return out

--- ranges[model, paths]: the [at, size] ranges of theta the named
--- parameters take, in theta's order, for an optimizer's group
--- (`optim.param_group[nn.ranges[model, ['0.weight']], map[lr = 0.01]]`); a
--- path naming a part (`0`, `encoder.1`) takes every parameter inside it
fn ranges[model, paths]
    out = []
    for path in paths
        found = false
        for p in named[model]
            if p.path eq path or starts[p.path, '`path`.']
                out = push[out, [p.at, shapes.product[p.dims]]]
                found = true
        if not found
            halt['no parameter or part `path` in a `model.form` layer']
    return out

--- the gradient ---------------------------------------------------------------

--- total_norm[model, g]: the norm of the norms of g's parameters, each
--- taken alone as PyTorch takes each parameter's gradient
--- (torch.nn.utils.get_total_norm); norm_type m.inf is the largest number
--- held
fn total_norm[model, g, norm_type = 2.0]
    if len[g] ne size[model]
        halt['the gradient holds `len[g]` numbers and the model `size[model]`']
    norms = []
    for p in named[model]
        piece = slice[g, p.at, p.at + shapes.product[p.dims]]
        norms = push[norms, _vector_norm[piece, norm_type]]
    return _vector_norm[m.tensor[norms], norm_type]

fn _vector_norm[v, p]
    if len[v] eq 0
        return 0.0
    if p eq m.inf
        return m.max[m.abs[v]]
    if p eq 2.0
        return sqrt[m.sum[v .* v]]
    if p eq 1.0
        return m.sum[m.abs[v]]
    return m.sum[m.abs[v] .^ p] ^ (1.0 / p)

--- clip_grad_norm[model, g, max_norm]: g scaled so its total norm is at
--- most max_norm (torch.nn.utils.clip_grad_norm_, which scales by
--- max_norm / (norm + 1e-6) where that is below 1)
fn clip_grad_norm[model, g, max_norm, norm_type = 2.0]
    total = total_norm[model, g, norm_type]
    coef = float[max_norm] / (total + 0.000001)
    if coef gt 1.0
        coef = 1.0
    return g * coef

--- clip_grad_value[g, clip_value]: each number of g held within
--- ±clip_value (torch.nn.utils.clip_grad_value_)
fn clip_grad_value[g, clip_value]
    return m.clip[g, -float[clip_value], float[clip_value]]

--- state[model, theta]: each parameter by its name, laid in its sizes
--- (PyTorch's state_dict, the buffers aside)
fn state[model, theta]
    out = map[]
    for p in named[model]
        out[p.path] = shapes.laid[m.flatten[_numbers[theta, p.at, shapes.product[p.dims]]], p.dims]
    return out

--- from_state[model, given]: theta from parameters by name, as PyTorch's
--- load_state_dict reads them: each named one present, of its number of
--- numbers
fn from_state[model, given]
    out = m.zeros[0]
    for p in named[model]
        if not (p.path in given)
            halt['no parameter `p.path` in the state given']
        t = m.flatten[given[p.path]]
        n = shapes.product[p.dims]
        if len[t] ne n
            halt['`p.path` holds `len[t]` numbers, and the model takes `n`']
        out = concat[out, t]
    return out

--- training --------------------------------------------------------------------

--- train[model] and eval[model]: the model with every layer training or not
--- (a dropout drops, a batch norm reads the batch, only in training)
fn train[model]
    return _trained[model, true]

fn eval[model]
    return _trained[model, false]

fn _trained[layer, on]
    out = layer
    out.training = on
    kids = []
    for p in layer.parts
        kids = push[kids, _trained[p, on]]
    out.parts = kids
    return out

--- a layer's output and the layer as running it leaves it
struct Tracked [out, layer]

--- tracked[model, theta, x]: the model with each training batch norm's
--- running statistics moved by the batch x, as PyTorch's forward pass moves
--- them (a sequential's parts in turn; a part of a model the program runs
--- is tracked with its own input)
fn tracked[model, theta, x]
    return _tracked[model, theta, m.flatten[x], x.shape].layer

--- (flat numbers and their sizes, as `_run` takes them)
fn _tracked[layer, theta, v, dims]
    if layer.form eq 'sequential'
        h = v
        d = dims
        kids = []
        for p in layer.parts
            t = _tracked[p, theta, h, d]
            h = t.out
            d = _after[p, d]
            kids = push[kids, t.layer]
        out = layer
        out.parts = kids
        return Tracked[h, out]
    return Tracked[_run[layer, theta, v, dims], _moved[layer, v, dims]]

--- a training batch norm with its running mean and variance moved toward
--- the batch's by its momentum (the variance unbiased, as PyTorch's), and its
--- count of batches one more; any other layer as it is
fn _moved[layer, numbers, dims]
    if layer.form ne 'batch_norm' or not layer.training or not layer.flags[1]
        return layer
    c = layer.ints[0]
    momentum = layer.floats[1]
    x = _channeled[numbers, dims]
    mu = functional.batch_mean[x]
    v = functional.batch_var[x, mu]
    n = len[numbers] / c
    unbiased = v * (float[n] / float[n - 1])
    held = layer.held
    mean_run = slice[held, 0, c] * (1.0 - momentum) + mu * momentum
    var_run = slice[held, c, 2 * c] * (1.0 - momentum) + unbiased * momentum
    out = layer
    out.held = concat[concat[mean_run, var_run], slice[held, 2 * c, 2 * c + 1] + 1.0]
    return out

--- running_mean[layer] and running_var[layer]: a batch norm's buffers
fn running_mean[layer]
    c = layer.ints[0]
    return slice[layer.held, 0, c]

fn running_var[layer]
    c = layer.ints[0]
    return slice[layer.held, c, 2 * c]
