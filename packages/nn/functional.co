--- `use nn.functional`: the functions of tensors a network is written in,
--- PyTorch's torch.nn.functional. Each is the formula PyTorch computes, in
--- float64, written over crow's math builtins and differentiated by `grad`
--- as any function is: there is no rule of its own, and a function with a
--- kink is written with `where` of a mask, so its gradient at the kink is
--- PyTorch's. A tensor may have any rank unless a function says; a `dim`
--- counts from the end when it is negative. A loss answers a number, the
--- mean of its terms or their sum (`reduction`); its `_each` form answers
--- the term of each item, as PyTorch's `reduction='none'` does.
use math
use shapes, windows, single

--- zeros of x's shape (x times 0: its rank stays known)
fn _zeros_like[x]
    return x * 0.0

--- x where it is no more than 0, and 0 elsewhere: what an exponential is
--- taken of where only x ≤ 0 is kept, so the side not taken cannot
--- overflow (`where` computes both, and 0 · ∞ is no gradient)
fn _below[x]
    return where[x gt 0.0, _zeros_like[x], x]

--- exp(−x), x held above −709 so the exponential is finite: a sigmoid of
--- a number below that is 0 to 300 digits, and its gradient stays one
fn _exp_neg[x]
    return exp[-clip[x, -709.0, inf]]

--- relu[x]: max(0, x)
fn relu[x]
    return clip[x, 0.0, inf]

--- relu6[x]: min(max(0, x), 6)
fn relu6[x]
    return clip[x, 0.0, 6.0]

--- hardtanh[x]: x held to [lo, hi]; the gradient passes strictly inside
--- them, as PyTorch's
fn hardtanh[x, lo = -1.0, hi = 1.0]
    return clip[x, lo, hi]

--- leaky_relu[x]: x where it is positive, slope · x elsewhere
fn leaky_relu[x, slope = 0.01]
    return where[x gt 0.0, x, x * slope]

--- elu[x]: x where it is positive, alpha · (exp(x) − 1) elsewhere
fn elu[x, alpha = 1.0]
    return where[x gt 0.0, x, expm1[_below[x]] * alpha]

--- selu[x]: scale · elu(x, alpha), with PyTorch's two constants
fn selu[x]
    scale = 1.0507009873554804934193349852946
    alpha = 1.6732632423543772848170429916717
    return where[x gt 0.0, x * scale, expm1[_below[x]] * (alpha * scale)]

--- celu[x]: x where it is positive, alpha · (exp(x / alpha) − 1) elsewhere
fn celu[x, alpha = 1.0]
    return where[x gt 0.0, x, expm1[_below[x] * (1.0 / alpha)] * alpha]

--- gelu[x]: x · Φ(x), Φ the normal distribution's cumulative,
--- 0.5 · (1 + erf(x / √2)); with approximate = 'tanh' PyTorch's tanh form,
--- 0.5 · x · (1 + tanh(√(2/π) · (x + 0.044715 · x³)))
fn gelu[x, approximate = 'none']
    if approximate eq 'tanh'
        inner = (x + x .* x .* x * 0.044715) * 0.7978845608028654
        return x * 0.5 .* (1.0 + math.tanh[inner])
    if approximate ne 'none'
        halt['gelu: approximate is none or tanh, got `approximate`']
    return x * 0.5 .* (1.0 + erf[x * 0.7071067811865476])

--- sigmoid[x]: 1 / (1 + exp(−x))
fn sigmoid[x]
    return 1.0 / (1.0 + _exp_neg[x])

--- silu[x]: x · sigmoid(x), x / (1 + exp(−x))
fn silu[x]
    return x ./ (1.0 + _exp_neg[x])

--- softsign[x]: x / (1 + |x|)
fn softsign[x]
    return x ./ (1.0 + abs[x])

--- softplus[x]: ln(1 + exp(beta · x)) / beta, and x itself where
--- beta · x passes the limit (PyTorch's `threshold`, 20)
fn softplus[x, beta = 1.0, limit = 20.0]
    bx = x * beta
    over = bx gt limit
    return where[over, x, log1p[exp[where[over, _zeros_like[x], bx]]] / beta]

--- mish[x]: x · tanh(softplus(x))
fn mish[x]
    return x .* math.tanh[softplus[x]]

--- logsigmoid[x]: ln(sigmoid(x)), min(x, 0) − ln(1 + exp(−|x|)): each
--- side smooth, so the gradient at 0 is 1/2
fn logsigmoid[x]
    up = x gte 0.0
    pos = where[up, x, _zeros_like[x]]
    neg = where[up, _zeros_like[x], x]
    return where[up, -log1p[exp[-pos]], neg - log1p[exp[neg]]]

--- tanhshrink[x]: x − tanh(x)
fn tanhshrink[x]
    return x - math.tanh[x]

--- softshrink[x]: x − lambd above lambd, x + lambd below −lambd, 0 between
fn softshrink[x, lambd = 0.5]
    return where[x gt lambd, x - lambd, where[x lt -lambd, x + lambd, _zeros_like[x]]]

--- hardshrink[x]: x outside [−lambd, lambd], 0 within
fn hardshrink[x, lambd = 0.5]
    return where[x gt lambd, x, where[x lt -lambd, x, _zeros_like[x]]]

--- threshold[x, limit, value]: x above the limit, `value` elsewhere
fn threshold[x, limit, value]
    return where[x gt limit, x, _zeros_like[x] + value]

--- hardsigmoid[x]: relu6(x + 3) / 6
fn hardsigmoid[x]
    return clip[x + 3.0, 0.0, 6.0] / 6.0

--- hardswish[x]: x · relu6(x + 3) / 6, with PyTorch's gradient at ±3 (0
--- at −3, 1 at 3)
fn hardswish[x]
    low = x lte -3.0
    high = x gte 3.0
    return where[low, x * 0.0, where[high, x * 6.0 / 6.0, x .* (x + 3.0) / 6.0]]

--- prelu[x, weight]: x where it is positive, weight · x elsewhere: one
--- weight, or one per channel (axis 1 of x)
fn prelu[x, weight]
    s = x.shape
    if len[math.flatten[weight]] eq 1 or len[s] lt 2
        return where[x gt 0.0, x, x .* weight]
    dims = []
    for i in range[len[s]]
        d = 1
        if i eq 1
            d = s[1]
        dims = push[dims, d]
    per = shapes.laid[math.flatten[weight], dims]
    return where[x gt 0.0, x, x .* per]

--- narrow[x, dim, start, length]: the `length` items of axis `dim` from
--- `start`, as PyTorch's narrow (a view there, the numbers read here; the
--- gradient reaches them)
fn narrow[x, dim, start, length]
    a = shapes.axis[x, dim]
    s = x.shape
    if start lt 0 or length lt 0 or start + length gt s[a]
        halt['narrow: items `start` to `start + length` of an axis of `s[a]`']
    if a eq 0
        return slice[x, start, start + length]
    outer = shapes.product[slice[s, 0, a]]
    inner = shapes.product[slice[s, a + 1, len[s]]]
    first = reshape[tensor[range[outer]], outer, 1, 1] * float[s[a] * inner]
    along = reshape[tensor[range[start, start + length]], 1, length, 1] * float[inner]
    within = reshape[tensor[range[inner]], 1, 1, inner]
    return shapes.laid[math.flatten[x[first + along + within]], shapes.with_size[s, a, length]]

--- glu[x]: the first half of axis `dim` times the sigmoid of the second
fn glu[x, dim = -1]
    a = shapes.axis[x, dim]
    n = x.shape[a]
    if n % 2 ne 0
        halt['glu: axis `a` holds `n` items, which do not halve']
    return narrow[x, a, 0, n / 2] .* sigmoid[narrow[x, a, n / 2, n / 2]]

--- softmax[x]: exp(x) / sum(exp(x)) along `dim`, its largest taken out of
--- the exponentials first
fn softmax[x, dim = -1]
    a = shapes.axis[x, dim]
    s = x.shape
    ex = exp[x - shapes.kept[math.flatten[max[x, a]], s, a]]
    return ex .* (1.0 / shapes.kept[math.flatten[sum[ex, a]], s, a])

--- log_softmax[x]: x − ln(sum(exp(x))) along `dim`
fn log_softmax[x, dim = -1]
    a = shapes.axis[x, dim]
    s = x.shape
    shifted = x - shapes.kept[math.flatten[max[x, a]], s, a]
    return shifted - shapes.kept[math.flatten[ln[sum[exp[shifted], a]]], s, a]

--- softmin[x]: the softmax of −x
fn softmin[x, dim = -1]
    return softmax[-x, dim]

--- the p-norm along axis `a` (2, 1 or any other p > 0), its gradient 0
--- where the items are all 0, as PyTorch's
fn _norm_along[x, p, a]
    if p eq 1.0
        return sum[abs[x], a]
    if p eq 2.0
        squares = sum[x .* x, a]
        some = squares gt 0.0
        root = sqrt[where[some, squares, _zeros_like[squares] + 1.0]]
        return where[some, root, _zeros_like[squares]]
    powers = sum[abs[x] .^ p, a]
    some = powers gt 0.0
    root = where[some, powers, _zeros_like[powers] + 1.0] .^ (1.0 / p)
    return where[some, root, _zeros_like[powers]]

--- normalize[x]: x over its p-norm along `dim`, the norm held no less
--- than eps
fn normalize[x, p = 2.0, dim = 1, eps = 0.000000000001]
    a = shapes.axis[x, dim]
    n = _norm_along[x, p, a]
    return x ./ shapes.kept[math.flatten[where[n gt eps, n, n * 0.0 + eps]], x.shape, a]

--- dropout[x, p, training, noise]: each number kept where its draw is 1
--- and scaled by 1 / (1 − p), as PyTorch's (x · (noise / (1 − p))); x
--- itself when not training or p is 0, zeros where p is 1. The draws are
--- the generator's, as PyTorch's dropout draws them from its own: noise
--- holds, for each number of x in order, 1 with probability 1 − p —
--- `rng.bernoulli[g, n, 1.0 - p].values` — and nn.dropout_noise draws every
--- dropout a model's forward pass runs. In training, with p between 0 and
--- 1, a dropout takes its noise
fn dropout[x, p = 0.5, training = true, noise = -1.0]
    if p lt 0.0 or p gt 1.0
        halt['dropout: p is a probability from 0 to 1, got `p`']
    if (not training) or p eq 0.0
        return x
    if p eq 1.0
        return x * 0.0
    keep = noise_of[noise, len[math.flatten[x]], 'dropout']
    return x .* shapes.laid[keep / (1.0 - p), x.shape]

--- noise_of[noise, n, what]: the draws a dropout reads, flat — n of them,
--- each 0 or 1; −1, the noise of none, halts (a dropout in training reads
--- its draws)
fn noise_of[noise, n, what]
    given = math.flatten[math.zeros[1] + noise]
    if len[given] eq 1 and given[0] lt 0.0
        halt['`what` in training reads its draws: hand it noise of `n` numbers — rng.bernoulli[g, `n`, 1.0 - p].values draws them as PyTorch draws them, and nn.dropout_noise draws a model’s']
    if len[given] ne n
        halt['`what`: the noise holds `len[given]` numbers, and `n` are drawn']
    return given

--- dropout1d[x, p, training, noise]: each channel of x `[n, c, l]` (or
--- `[c, l]`) zeroed whole where its draw is 0 and the rest scaled by 1 /
--- (1 − p) (F.dropout1d); dropout2d and dropout3d over two and three
--- spatial axes. One draw a channel, in order (n·c of them, or c), as
--- PyTorch draws them; dropout2d of three axes reads them `[n, c, l]`, as
--- PyTorch 2.8 does (with its warning)
fn dropout1d[x, p = 0.5, training = true, noise = -1.0]
    return _channel_dropout[math.flatten[x], x.shape, p, training, 1, 'dropout1d', noise]

fn dropout2d[x, p = 0.5, training = true, noise = -1.0]
    if len[x.shape] eq 3
        return _channel_dropout[math.flatten[x], x.shape, p, training, 1, 'dropout2d', noise]
    return _channel_dropout[math.flatten[x], x.shape, p, training, 2, 'dropout2d', noise]

fn dropout3d[x, p = 0.5, training = true, noise = -1.0]
    return _channel_dropout[math.flatten[x], x.shape, p, training, 3, 'dropout3d', noise]

--- channels[dims, d, what]: how many draws a channel dropout over d
--- spatial axes reads of a tensor of sizes dims (dropout2d of three axes
--- reads d as 1)
fn channels[dims, d, what]
    if d eq 2 and len[dims] eq 3
        return windows.planes_of[dims, 1, what].count
    return windows.planes_of[dims, d, what].count

--- (the flat numbers v of a tensor laid `dims`, so one copy takes every rank)
fn _channel_dropout[v, dims, p, training, d, what, noise]
    if p lt 0.0 or p gt 1.0
        halt['`what`: p is a probability from 0 to 1, got `p`']
    if (not training) or p eq 0.0
        return shapes.laid[v, dims]
    if p eq 1.0
        return shapes.laid[v * 0.0, dims]
    given = windows.planes_of[dims, d, what]
    keep = noise_of[noise, given.count, what] / (1.0 - p)
    inner = shapes.product[given.sizes]
    mask = math.flatten[reshape[keep, given.count, 1] + reshape[math.zeros[inner], 1, inner]]
    return shapes.laid[v .* mask, dims]

--- linear[x, w, b]: x · wᵀ + b, the weight laid `[outs, ins]` as
--- PyTorch's, x of any rank with ins its last axis
fn linear[x, w, b = 0.0]
    s = x.shape
    outs = w.shape[0]
    ins = w.shape[1]
    if s[len[s] - 1] ne ins
        halt['linear: x ends in `s[len[s] - 1]` features and the weight takes `ins`']
    rows = len[math.flatten[x]] / ins
    y = reshape[x, rows, ins] * transpose[reshape[w, outs, ins]] + b
    return shapes.laid[math.flatten[y], push[slice[s, 0, len[s] - 1], outs]]

--- bilinear[x1, x2, w, b]: x1ᵀ · w[k] · x2 + b[k] for each output k, the
--- weight `[outs, in1, in2]`, x1 `[n, in1]` and x2 `[n, in2]`
fn bilinear[x1, x2, w, b = 0.0]
    outs = w.shape[0]
    in1 = w.shape[1]
    in2 = w.shape[2]
    n = len[math.flatten[x1]] / in1
    a = reshape[x1, n, in1]
    c = reshape[x2, n, in2]
    --- each output's x1ᵀ · w[k] · x2, the sum over in2 of (x1 · w[k]) .* x2,
    --- joined as columns
    y = reshape[sum[(a * reshape[narrow[w, 0, 0, 1], in1, in2]) .* c, 1], n, 1]
    for k in range[1, outs]
        wk = reshape[narrow[w, 0, k, 1], in1, in2]
        y = concat[y, reshape[sum[(a * wk) .* c, 1], n, 1], axis = 1]
    return y + b

--- embedding[ids, w]: the rows of w at the ids (whole numbers), laid like
--- the ids with the row's width last
fn embedding[ids, w]
    dim = w.shape[1]
    n = len[math.flatten[ids]]
    first = reshape[math.flatten[ids], n, 1] * float[dim]
    cols = reshape[tensor[range[dim]], 1, dim]
    return shapes.laid[math.flatten[w[first + cols]], push[ids.shape, dim]]

--- one_hot[ids, classes]: a row of `classes` numbers for each id, 1 at
--- the id
fn one_hot[ids, classes]
    return shapes.laid[math.flatten[onehot[math.flatten[ids], classes]], push[ids.shape, classes]]

--- the mean of each row of a matrix, as a column
fn _row_mean[z]
    return reshape[mean[z, 1], len[z], 1]

--- the biased variance of each row of a matrix about its mean `mu`, as a
--- column
fn _row_var[z, mu]
    c = z - mu
    return reshape[mean[c .* c, 1], len[z], 1]

--- the numbers of x's last len(shape) axes, the axes a normalization
--- reads (`shape` names them as PyTorch's normalized_shape does)
fn _trailing[x, shape]
    s = x.shape
    k = len[shape]
    if k gt len[s]
        halt['a normalized shape of `k` axes, and x has `len[s]`']
    return shapes.product[slice[s, len[s] - k, len[s]]]

--- layer_norm[x, shape, w, b]: x over its last len(shape) axes, less their
--- mean, over the root of their variance plus eps, scaled by w and moved
--- by b (each of `shape`, or 1 and 0)
fn layer_norm[x, shape, w = 1.0, b = 0.0, eps = 0.00001]
    width = _trailing[x, shape]
    rows = len[math.flatten[x]] / width
    z = reshape[x, rows, width]
    mu = _row_mean[z]
    rstd = 1.0 / sqrt[_row_var[z, mu] + eps]
    y = shapes.laid[math.flatten[(z - mu) .* rstd], x.shape]
    return y .* w + b

--- rms_norm[x, shape, w]: x over the root of the mean of its squares over
--- its last len(shape) axes plus eps (PyTorch's float64 epsilon unless
--- given), scaled by w
fn rms_norm[x, shape, w = 1.0, eps = 0.0000000000000002220446049250313]
    width = _trailing[x, shape]
    rows = len[math.flatten[x]] / width
    z = reshape[x, rows, width]
    scale = 1.0 / sqrt[reshape[mean[z .* z, 1], rows, 1] + eps]
    return shapes.laid[math.flatten[z .* scale], x.shape] .* w

--- the shape that lays a channel's numbers `[c]` along axis 1 of a tensor
--- of `axes` axes
fn _channels[c, axes]
    dims = []
    for i in range[axes]
        d = 1
        if i eq 1
            d = c
        dims = push[dims, d]
    return dims

--- x `[N, C, …]` as `[N, C, M]`, M the numbers of a channel in one item
fn _by_channel[x]
    s = x.shape
    return reshape[x, s[0], s[1], len[math.flatten[x]] / (s[0] * s[1])]

--- the mean of each channel (axis 1) of x `[N, C, …]`, over the batch and
--- every other axis
fn batch_mean[x]
    z = _by_channel[x]
    return sum[sum[z, 2], 0] / float[len[z] * z.shape[2]]

--- the biased variance of each channel of x about its mean `mu`
fn batch_var[x, mu]
    z = _by_channel[x]
    d = z - reshape[mu, 1, z.shape[1], 1]
    return sum[sum[d .* d, 2], 0] / float[len[z] * z.shape[2]]

--- batch_norm[x, running_mean, running_var]: x `[N, C, …]` less each
--- channel's mean, over the root of its variance plus eps, scaled by w and
--- moved by b per channel. Training, the batch's own mean and biased
--- variance; else the running ones given. (The running ones a training
--- step leaves are nn.track's: a function answers one value.)
fn batch_norm[x, running_mean, running_var, w = 1.0, b = 0.0, training = false, momentum = 0.1, eps = 0.00001]
    s = x.shape
    c = s[1]
    laid = _channels[c, len[s]]
    mu = running_mean
    v = running_var
    if training
        mu = batch_mean[x]
        v = batch_var[x, mu]
    invstd = 1.0 / sqrt[v + eps]
    y = (x - shapes.laid[math.flatten[mu], laid]) .* shapes.laid[math.flatten[invstd], laid]
    return y .* shapes.laid[math.flatten[math.zeros[c] + w], laid] + shapes.laid[math.flatten[math.zeros[c] + b], laid]

--- group_norm[x, groups]: x `[N, C, …]` normalized over each group of
--- C / groups channels and every other axis, then scaled and moved per
--- channel
fn group_norm[x, groups, w = 1.0, b = 0.0, eps = 0.00001]
    s = x.shape
    n = s[0]
    c = s[1]
    if c % groups ne 0
        halt['group_norm: `c` channels do not split into `groups` groups']
    z = reshape[x, n * groups, len[math.flatten[x]] / (n * groups)]
    mu = _row_mean[z]
    y = shapes.laid[math.flatten[(z - mu) .* (1.0 / sqrt[_row_var[z, mu] + eps])], s]
    laid = _channels[c, len[s]]
    return y .* shapes.laid[math.flatten[math.zeros[c] + w], laid] + shapes.laid[math.flatten[math.zeros[c] + b], laid]

--- instance_norm[x]: each channel of each item of x `[N, C, …]` over its
--- own numbers
fn instance_norm[x, w = 1.0, b = 0.0, eps = 0.00001]
    return group_norm[x, x.shape[1], w, b, eps]

--- cosine_similarity[x1, x2]: x1 · x2 over the product of their norms
--- along `dim`, each norm held no less than eps
fn cosine_similarity[x1, x2, dim = 1, eps = 0.00000001]
    a = shapes.axis[x1, dim]
    n1 = _norm_along[x1, 2.0, a]
    n2 = _norm_along[x2, 2.0, a]
    held1 = shapes.kept[math.flatten[where[n1 gt eps, n1, n1 * 0.0 + eps]], x1.shape, a]
    held2 = shapes.kept[math.flatten[where[n2 gt eps, n2, n2 * 0.0 + eps]], x2.shape, a]
    return sum[(x1 ./ held1) .* (x2 ./ held2), a]

--- pairwise_distance[x1, x2]: the p-norm of x1 − x2 + eps along the last
--- axis
fn pairwise_distance[x1, x2, p = 2.0, eps = 0.000001]
    d = x1 - x2 + eps
    return _norm_along[d, p, len[d.shape] - 1]

--- the losses -------------------------------------------------------------

--- a loss's terms reduced: their mean or their sum
fn _reduce[terms, reduction, name]
    if reduction eq 'mean'
        return mean[terms]
    if reduction eq 'sum'
        return sum[terms]
    halt['`name`: reduction is mean or sum (`name`_each answers each term), got `reduction`']

--- mse_loss: (x − target)²
fn mse_loss_each[x, target]
    d = x - target
    return d .* d

fn mse_loss[x, target, reduction = 'mean']
    return _reduce[math.flatten[mse_loss_each[x, target]], reduction, 'mse_loss']

--- l1_loss: |x − target|
fn l1_loss_each[x, target]
    return abs[x - target]

fn l1_loss[x, target, reduction = 'mean']
    return _reduce[math.flatten[l1_loss_each[x, target]], reduction, 'l1_loss']

--- smooth_l1_loss: 0.5 · z² / beta where z = |x − target| is below
--- beta, z − 0.5 · beta elsewhere
fn smooth_l1_loss_each[x, target, beta = 1.0]
    z = abs[x - target]
    if beta eq 0.0
        return z
    return where[z lt beta, z .* z * 0.5 / beta, z - 0.5 * beta]

fn smooth_l1_loss[x, target, reduction = 'mean', beta = 1.0]
    return _reduce[math.flatten[smooth_l1_loss_each[x, target, beta]], reduction, 'smooth_l1_loss']

--- huber_loss: 0.5 · z² where z = |x − target| is below delta,
--- delta · (z − 0.5 · delta) elsewhere
fn huber_loss_each[x, target, delta = 1.0]
    z = abs[x - target]
    return where[z lt delta, z .* z * 0.5, (z - 0.5 * delta) * delta]

fn huber_loss[x, target, reduction = 'mean', delta = 1.0]
    return _reduce[math.flatten[huber_loss_each[x, target, delta]], reduction, 'huber_loss']

--- ln(x) held no lower than −100, as PyTorch's binary cross-entropy holds
--- it: 0 reads as −100, never −∞
fn _ln_floor[x]
    pos = x gt 0.0
    lnx = ln[where[pos, x, _zeros_like[x] + 1.0]]
    least = _zeros_like[x] - 100.0
    return where[pos, where[lnx gt -100.0, lnx, least], least]

--- ln(1 − x), held as ln is above
fn _ln1m_floor[x]
    pos = x lt 1.0
    l = log1p[-where[pos, x, _zeros_like[x]]]
    least = _zeros_like[x] - 100.0
    return where[pos, where[l gt -100.0, l, least], least]

--- binary_cross_entropy: −(t · ln x + (1 − t) · ln(1 − x)) of
--- probabilities x, each logarithm held no lower than −100; weighted by
--- `weight`, which broadcasts
fn binary_cross_entropy_each[x, target, weight = 1.0]
    if min[x] lt 0.0 or max[x] gt 1.0
        halt['binary_cross_entropy: x holds probabilities, from 0 to 1']
    return ((target - 1.0) .* _ln1m_floor[x] - target .* _ln_floor[x]) .* weight

fn binary_cross_entropy[x, target, weight = 1.0, reduction = 'mean']
    return _reduce[math.flatten[binary_cross_entropy_each[x, target, weight]], reduction, 'binary_cross_entropy']

--- binary_cross_entropy_with_logits: the binary cross-entropy of
--- sigmoid(x), (1 − t) · x − ln(sigmoid(x)), the positives weighted by
--- pos_weight and every term by weight
fn binary_cross_entropy_with_logits_each[x, target, weight = 1.0, pos_weight = 1.0]
    lw = (pos_weight - 1.0) .* target + 1.0
    return ((1.0 - target) .* x - lw .* logsigmoid[x]) .* weight

fn binary_cross_entropy_with_logits[x, target, weight = 1.0, reduction = 'mean', pos_weight = 1.0]
    return _reduce[math.flatten[binary_cross_entropy_with_logits_each[x, target, weight, pos_weight]], reduction, 'binary_cross_entropy_with_logits']

--- scores `[N, C]` of a batch, or `[C]` of one item as a batch of one
fn _rows[x]
    s = x.shape
    if len[s] eq 1
        return reshape[x, 1, s[0]]
    if len[s] ne 2
        halt['scores are [classes] or [batch, classes], got `len[s]` axes']
    return reshape[x, s[0], s[1]]

--- each row's number at its target class
fn _picked[m, target]
    n = m.shape[0]
    c = m.shape[1]
    return m[tensor[range[n]] * float[c] + math.flatten[target]]

--- the classes as whole numbers from 0 to c − 1, one per row, or stop
fn _classes[target, n, c, ignore_index]
    t = math.flatten[target]
    if len[t] ne n
        halt['one target per row of scores (`n`), got `len[t]`']
    kept = where[t eq ignore_index, _zeros_like[t], t]
    if len[t] gt 0
        if min[kept] lt 0.0 or max[kept] gte float[c] or max[abs[kept - round[kept]]] gt 0.0
            halt['a target is a class of `c`, a whole number from 0 to `c - 1`']
    return kept

--- nll_loss: −w[t] · x[t] of log-probabilities `[N, C]` at each row's
--- class t; a row whose target is ignore_index adds nothing
fn nll_loss_each[x, target, weight = 1.0, ignore_index = -100]
    m = _rows[x]
    n = m.shape[0]
    c = m.shape[1]
    t = _classes[target, n, c, ignore_index]
    counted = _counted[target, n, ignore_index]
    w = (math.zeros[c] + weight)[t] .* counted
    return -_picked[m, t] .* w

--- 1 for each row whose target is a class, 0 where it is ignore_index
fn _counted[target, n, ignore_index]
    t = math.flatten[target]
    return where[t eq ignore_index, math.zeros[n], math.ones[n]]

--- the weight of each row's class, 0 where the row is ignored
fn _row_weights[target, n, c, weight, ignore_index]
    t = _classes[target, n, c, ignore_index]
    counted = _counted[target, n, ignore_index]
    return (math.zeros[c] + weight)[t] .* counted

fn nll_loss[x, target, weight = 1.0, ignore_index = -100, reduction = 'mean']
    terms = nll_loss_each[x, target, weight, ignore_index]
    if reduction eq 'mean'
        m = _rows[x]
        return sum[terms] / sum[_row_weights[target, m.shape[0], m.shape[1], weight, ignore_index]]
    return _reduce[math.flatten[terms], reduction, 'nll_loss']

--- cross_entropy: the negative log-softmax of each row's scores at its
--- class, or against a row of probabilities when the target is shaped as
--- the scores; label_smoothing mixes in the uniform distribution, as
--- PyTorch's
fn cross_entropy_each[x, target, weight = 1.0, ignore_index = -100, label_smoothing = 0.0]
    m = _rows[x]
    n = m.shape[0]
    c = m.shape[1]
    logp = log_softmax[m, 1]
    w = math.zeros[c] + weight
    if target.shape eq x.shape
        p = _rows[target]
        if label_smoothing gt 0.0
            p = p * (1.0 - label_smoothing) + label_smoothing / float[c]
        return -sum[logp .* p .* reshape[w, 1, c], 1]
    nll = nll_loss_each[logp, target, weight, ignore_index]
    if label_smoothing eq 0.0
        return nll
    counted = _counted[target, n, ignore_index]
    smooth = -sum[logp .* reshape[w, 1, c], 1] .* counted
    return nll * (1.0 - label_smoothing) + smooth * (label_smoothing / float[c])

fn cross_entropy[x, target, weight = 1.0, ignore_index = -100, reduction = 'mean', label_smoothing = 0.0]
    if reduction ne 'mean' and reduction ne 'sum'
        halt['cross_entropy: reduction is mean or sum (cross_entropy_each answers each term), got `reduction`']
    m = _rows[x]
    n = m.shape[0]
    c = m.shape[1]
    logp = log_softmax[m, 1]
    w = math.zeros[c] + weight
    if target.shape eq x.shape
        p = _rows[target]
        if label_smoothing gt 0.0
            p = p * (1.0 - label_smoothing) + label_smoothing / float[c]
        total = -sum[logp .* p .* reshape[w, 1, c]]
        if reduction eq 'mean'
            return total / float[n]
        return total
    nll = nll_loss[logp, target, weight, ignore_index, reduction]
    if label_smoothing eq 0.0
        return nll
    counted = _counted[target, n, ignore_index]
    smooth = sum[-sum[logp .* reshape[w, 1, c], 1] .* counted]
    if reduction eq 'mean'
        smooth = smooth / sum[_row_weights[target, n, c, weight, ignore_index]]
    return nll * (1.0 - label_smoothing) + smooth * (label_smoothing / float[c])

--- x · ln(y), 0 where x is 0
fn _xlogy[x, y]
    fx = math.flatten[x]
    fy = math.flatten[y]
    zero = fx eq 0.0
    return shapes.laid[math.flatten[where[zero, fx * 0.0, fx .* ln[where[zero, fy * 0.0 + 1.0, fy]]]], x.shape]

--- kl_div: target · (ln target − x) of log-probabilities `x`,
--- or of log-probabilities on both sides with log_target; reduction
--- 'batchmean' is the sum over the batch's size
fn kl_div_each[x, target, log_target = false]
    if log_target
        return exp[target] .* (target - x)
    return _xlogy[target, target] - target .* x

fn kl_div[x, target, reduction = 'mean', log_target = false]
    terms = kl_div_each[x, target, log_target]
    if reduction eq 'batchmean'
        return sum[terms] / float[x.shape[0]]
    return _reduce[math.flatten[terms], reduction, 'kl_div']

--- poisson_nll_loss: exp(x) − target · x of log-rates, or
--- x − target · ln(x + eps) of rates; complete (PyTorch's full) adds Stirling's term
--- where the target is above 1
fn poisson_nll_loss_each[x, target, log_input = true, complete = false, eps = 0.00000001]
    terms = exp[x] - target .* x
    if not log_input
        terms = x - target .* ln[x + eps]
    if not complete
        return terms
    big = target gt 1.0
    t = where[big, target, _zeros_like[target] + 1.0]
    stirling = t .* ln[t] - t + ln[t * (2.0 * pi)] * 0.5
    return terms + where[big, stirling, _zeros_like[target]]

fn poisson_nll_loss[x, target, log_input = true, complete = false, eps = 0.00000001, reduction = 'mean']
    return _reduce[math.flatten[poisson_nll_loss_each[x, target, log_input, complete, eps]], reduction, 'poisson_nll_loss']

--- gaussian_nll_loss: 0.5 · (ln v + (x − target)² / v) of predicted
--- means and variances v, each variance held no lower than eps
fn gaussian_nll_loss_each[x, target, var, complete = false, eps = 0.000001]
    if min[var] lt 0.0
        halt['gaussian_nll_loss: a variance is negative']
    v = where[var gt eps, var, _zeros_like[var] + eps]
    d = x - target
    terms = (ln[v] + d .* d ./ v) * 0.5
    if complete
        return terms + 0.5 * ln[2.0 * pi]
    return terms

fn gaussian_nll_loss[x, target, var, complete = false, eps = 0.000001, reduction = 'mean']
    return _reduce[math.flatten[gaussian_nll_loss_each[x, target, var, complete, eps]], reduction, 'gaussian_nll_loss']

--- margin_ranking_loss: max(0, −y · (x1 − x2) + margin), y 1 or −1
fn margin_ranking_loss_each[x1, x2, y, margin = 0.0]
    return relu[-y .* (x1 - x2) + margin]

fn margin_ranking_loss[x1, x2, y, margin = 0.0, reduction = 'mean']
    return _reduce[math.flatten[margin_ranking_loss_each[x1, x2, y, margin]], reduction, 'margin_ranking_loss']

--- hinge_embedding_loss: x where y is 1, max(0, margin − x) where it is −1
fn hinge_embedding_loss_each[x, y, margin = 1.0]
    return where[y ne 1.0, relu[margin - x], _zeros_like[x]] + where[y ne -1.0, x, _zeros_like[x]]

fn hinge_embedding_loss[x, y, margin = 1.0, reduction = 'mean']
    return _reduce[math.flatten[hinge_embedding_loss_each[x, y, margin]], reduction, 'hinge_embedding_loss']

--- soft_margin_loss: ln(1 + exp(−y · x))
fn soft_margin_loss_each[x, y]
    return log1p[exp[-y .* x]]

fn soft_margin_loss[x, y, reduction = 'mean']
    return _reduce[math.flatten[soft_margin_loss_each[x, y]], reduction, 'soft_margin_loss']

--- multilabel_soft_margin_loss: the mean over the classes of
--- −(y · ln sigmoid(x) + (1 − y) · ln sigmoid(−x)), one term per row
fn multilabel_soft_margin_loss_each[x, y, weight = 1.0]
    m = _rows[x]
    t = _rows[y]
    c = m.shape[1]
    terms = -(t .* logsigmoid[m] + (1.0 - t) .* logsigmoid[-m]) .* reshape[math.zeros[c] + weight, 1, c]
    return sum[terms, 1] / float[c]

fn multilabel_soft_margin_loss[x, y, weight = 1.0, reduction = 'mean']
    return _reduce[math.flatten[multilabel_soft_margin_loss_each[x, y, weight]], reduction, 'multilabel_soft_margin_loss']

--- cosine_embedding_loss: 1 − cos(x1, x2) where y is 1, max(0, cos − margin)
--- where it is −1, each row's cosine along axis 1
fn cosine_embedding_loss_each[x1, x2, y, margin = 0.0]
    eps = 0.000000000001
    a = len[x1.shape] - 1
    inner = sum[x1 .* x2, a]
    mag = sqrt[(sum[x1 .* x1, a] + eps) .* (sum[x2 .* x2, a] + eps)]
    cosine = inner ./ mag
    return where[y eq 1.0, 1.0 - cosine, _zeros_like[cosine]] + where[y eq -1.0, relu[cosine - margin], _zeros_like[cosine]]

fn cosine_embedding_loss[x1, x2, y, margin = 0.0, reduction = 'mean']
    return _reduce[math.flatten[cosine_embedding_loss_each[x1, x2, y, margin]], reduction, 'cosine_embedding_loss']

--- triplet_margin_loss: max(d(anchor, positive) − d(anchor, negative) +
--- margin, 0), d the pairwise distance; swap takes the nearer of the two
--- distances to the negative
fn triplet_margin_loss_each[anchor, positive, negative, margin = 1.0, p = 2.0, eps = 0.000001, swap = false]
    near = pairwise_distance[anchor, positive, p, eps]
    far = pairwise_distance[anchor, negative, p, eps]
    if swap
        other = pairwise_distance[positive, negative, p, eps]
        nearer = other - far
        far = where[nearer lt 0.0, other, far]
    return relu[margin + near - far]

fn triplet_margin_loss[anchor, positive, negative, margin = 1.0, p = 2.0, eps = 0.000001, swap = false, reduction = 'mean']
    return _reduce[math.flatten[triplet_margin_loss_each[anchor, positive, negative, margin, p, eps, swap]], reduction, 'triplet_margin_loss']

--- multi_margin_loss: the sum over the classes i other than y of
--- max(0, margin − x[y] + x[i])^p, weighted by w[y], over the classes
fn multi_margin_loss_each[x, y, p = 1, margin = 1.0, weight = 1.0]
    m = _rows[x]
    n = m.shape[0]
    c = m.shape[1]
    t = _classes[y, n, c, -100]
    own = reshape[_picked[m, t], n, 1]
    gap = relu[m - own + margin]
    if p eq 2
        gap = gap .* gap
    others = 1.0 - onehot[t, c]
    w = reshape[(math.zeros[c] + weight)[t], n, 1]
    return sum[gap .* others .* w, 1] / float[c]

fn multi_margin_loss[x, y, p = 1, margin = 1.0, weight = 1.0, reduction = 'mean']
    return _reduce[math.flatten[multi_margin_loss_each[x, y, p, margin, weight]], reduction, 'multi_margin_loss']

--- windows: convolutions, poolings, padding ------------------------------------

--- a list of whole numbers, given as a list or a vector of them
fn _whole[given]
    out = []
    for q in given
        out = push[out, int[q]]
    return out

--- conv1d[x, w, b, stride, padding, dilation, groups]: the
--- cross-correlation of x `[n, c, l]` (or `[c, l]`) with the weight
--- `[outs, c / groups, k]`, plus the bias per output channel (F.conv1d);
--- conv2d over `[n, c, h, w]` and conv3d over `[n, c, d, h, w]` alike.
--- stride, padding and dilation are an int or one per spatial axis, and
--- padding is also 'valid' (none) or 'same' (the input's size, for a
--- stride of 1); groups splits the channels into groups convolved apart.
--- The windows are gathered (im2col) and multiplied by the weight as one
--- matrix, as PyTorch's float64 kernel does
fn conv1d[x, w, b = 0.0, stride = 1, padding = 0, dilation = 1, groups = 1]
    return _conv[x, w, b, 1, stride, padding, dilation, groups, 'conv1d']

fn conv2d[x, w, b = 0.0, stride = 1, padding = 0, dilation = 1, groups = 1]
    return _conv[x, w, b, 2, stride, padding, dilation, groups, 'conv2d']

fn conv3d[x, w, b = 0.0, stride = 1, padding = 0, dilation = 1, groups = 1]
    return _conv[x, w, b, 3, stride, padding, dilation, groups, 'conv3d']

fn _conv[x, w, b, d, stride, padding, dilation, groups, what]
    wd = w.shape
    if len[wd] ne d + 2
        halt['`what`: the weight takes `d + 2` axes [outs, ins / groups, kernel], and has `len[wd]`']
    kernel = slice[wd, 2, len[wd]]
    st = windows.each[stride, d, 'stride']
    dl = windows.each[dilation, d, 'dilation']
    pads = windows.padding[padding, d, kernel, dl, st, what]
    given = windows.batch_of[x.shape, d, what]
    if given.channels ne wd[1] * groups
        halt['`what`: groups=`groups` and a weight of `wd[1]` channels in a group take `wd[1] * groups` channels, and the input has `given.channels`']
    v = conv_flat[math.flatten[x], given.n, given.channels, given.sizes, math.flatten[w], wd[0], kernel, b, st, pads, dl, groups, what]
    return shapes.laid[v, windows.batch_dims[given, wd[0], windows.outs[given.sizes, kernel, st, pads, dl, what]]]

--- conv_flat[v, n, c, sizes, wv, outs, kernel, b, stride, pads, dilation,
--- groups, what]: the convolution of a batch laid flat `[n, c, sizes]` with
--- a weight laid flat `[outs, c / groups, kernel]`, answered flat `[n,
--- outs, windows]` (a model's layers hand their numbers on flat)
fn conv_flat[v, n, c, sizes, wv, outs, kernel, b, stride, pads, dilation, groups, what]
    if groups lt 1 or c % groups ne 0 or outs % groups ne 0
        halt['`what`: `c` channels in and `outs` out must each be a multiple of groups=`groups`']
    at = windows.outs[sizes, kernel, stride, pads, dilation, what]
    t = windows.table[sizes, kernel, stride, pads.low, dilation, at]
    count = shapes.product[at]
    taps = shapes.product[kernel]
    plane = shapes.product[sizes]
    cg = c / groups
    og = outs / groups
    if len[wv] ne outs * cg * taps
        halt['`what`: the weight holds `len[wv]` numbers, and `outs` · `cg` · `taps` were expected']
    xp = concat[v, math.zeros[1]]
    y = _conv_group[xp, t, n, c, plane, wv, 0, cg, og, taps]
    for g in range[1, groups]
        y = concat[y, _conv_group[xp, t, n, c, plane, wv, g, cg, og, taps], axis = 1]
    y = y + (math.zeros[outs] + b)
    return math.flatten[math.flatten[y][windows.channels_first[n, count, outs]]]

fn _conv_group[xp, t, n, c, plane, wv, g, cg, og, taps]
    pos = windows.columns[t, n, c, plane, g * cg, cg]
    cols = reshape[xp[pos], pos.shape[0], pos.shape[1]]
    w = reshape[slice[wv, g * og * cg * taps, (g + 1) * og * cg * taps], og, cg * taps]
    return cols * transpose[w]

--- conv_transpose1d[x, w, b, stride, padding, output_padding, groups,
--- dilation]: the transposed convolution of x `[n, c, l]` with the weight
--- `[c, outs / groups, k]` (F.conv_transpose1d) — the gradient of conv1d
--- with respect to its input: each number spread over a window of the
--- output and the windows' overlaps added (col2im, in the order PyTorch's
--- kernel adds them); conv_transpose2d and conv_transpose3d alike. Along
--- an axis the output holds (l − 1)·stride − 2·padding + dilation·(k − 1)
--- + output_padding + 1
fn conv_transpose1d[x, w, b = 0.0, stride = 1, padding = 0, output_padding = 0, groups = 1, dilation = 1]
    return _conv_transposed[x, w, b, 1, stride, padding, output_padding, groups, dilation, 'conv_transpose1d']

fn conv_transpose2d[x, w, b = 0.0, stride = 1, padding = 0, output_padding = 0, groups = 1, dilation = 1]
    return _conv_transposed[x, w, b, 2, stride, padding, output_padding, groups, dilation, 'conv_transpose2d']

fn conv_transpose3d[x, w, b = 0.0, stride = 1, padding = 0, output_padding = 0, groups = 1, dilation = 1]
    return _conv_transposed[x, w, b, 3, stride, padding, output_padding, groups, dilation, 'conv_transpose3d']

fn _conv_transposed[x, w, b, d, stride, padding, output_padding, groups, dilation, what]
    wd = w.shape
    if len[wd] ne d + 2
        halt['`what`: the weight takes `d + 2` axes [ins, outs / groups, kernel], and has `len[wd]`']
    kernel = slice[wd, 2, len[wd]]
    st = windows.each[stride, d, 'stride']
    dl = windows.each[dilation, d, 'dilation']
    p = windows.each[padding, d, 'padding']
    op = windows.each[output_padding, d, 'output_padding']
    given = windows.batch_of[x.shape, d, what]
    if given.channels ne wd[0]
        halt['`what`: the weight takes `wd[0]` channels in, and the input has `given.channels`']
    outs = wd[1] * groups
    v = conv_transpose_flat[math.flatten[x], given.n, given.channels, given.sizes, math.flatten[w], outs, kernel, b, st, p, op, dl, groups, what]
    return shapes.laid[v, windows.batch_dims[given, outs, transposed_sizes[given.sizes, kernel, st, p, op, dl, what]]]

--- transposed_sizes[sizes, kernel, stride, padding, output_padding,
--- dilation, what]: the spatial sizes a transposed convolution answers
fn transposed_sizes[sizes, kernel, stride, padding, output_padding, dilation, what]
    out = []
    for j in range[len[sizes]]
        if output_padding[j] gte stride[j] and output_padding[j] gte dilation[j]
            halt['`what`: output padding must be smaller than either stride or dilation, but got output_padding=`output_padding[j]`, stride=`stride[j]` and dilation=`dilation[j]`']
        s = (sizes[j] - 1) * stride[j] - 2 * padding[j] + dilation[j] * (kernel[j] - 1) + output_padding[j] + 1
        if s lt 1
            halt['`what`: the output would hold `s` numbers along axis `j`']
        out = push[out, s]
    return out

--- conv_transpose_flat[v, n, c, sizes, wv, outs, kernel, b, stride,
--- padding, output_padding, dilation, groups, what]: the transposed
--- convolution of a batch laid flat `[n, c, sizes]` with a weight laid flat
--- `[c, outs / groups, kernel]`, answered flat `[n, outs, …]`
fn conv_transpose_flat[v, n, c, sizes, wv, outs, kernel, b, stride, padding, output_padding, dilation, groups, what]
    if groups lt 1 or c % groups ne 0 or outs % groups ne 0
        halt['`what`: `c` channels in and `outs` out must each be a multiple of groups=`groups`']
    at = transposed_sizes[sizes, kernel, stride, padding, output_padding, dilation, what]
    t = windows.table[at, kernel, stride, padding, dilation, sizes]
    count = shapes.product[sizes]
    plane = shapes.product[at]
    taps = shapes.product[kernel]
    cg = c / groups
    og = outs / groups
    if len[wv] ne c * og * taps
        halt['`what`: the weight holds `len[wv]` numbers, and `c` · `og` · `taps` were expected']
    f = windows.folded[t, plane, n, og, count * og * taps, taps, og * taps, 1, n * count * og * taps]
    y = _transposed_group[v, n, c, count, wv, 0, cg, og, taps, f, plane]
    for g in range[1, groups]
        y = concat[y, _transposed_group[v, n, c, count, wv, g, cg, og, taps, f, plane], axis = 1]
    bias = math.zeros[outs] + b
    rows = reshape[y, n * outs, plane] + reshape[bias[windows.channel_of_rows[n, outs]], n * outs, 1]
    return math.flatten[rows]

fn _transposed_group[v, n, c, count, wv, g, cg, og, taps, f, plane]
    pos = windows.channels_last[n, c, count, g * cg, cg]
    x = reshape[v[pos], pos.shape[0], pos.shape[1]]
    w = reshape[slice[wv, g * cg * og * taps, (g + 1) * cg * og * taps], cg, og * taps]
    cols = x * w
    return reshape[_summed[concat[math.flatten[cols], math.zeros[1]], f], n, og * plane]

--- the numbers of v at each row of positions, added along the row
fn _summed[v, positions]
    return sum[reshape[v[positions], positions.shape[0], positions.shape[1]], 1]

--- the largest number of v at each row of positions
fn _largest[v, positions]
    return max[reshape[v[positions], positions.shape[0], positions.shape[1]], 1]

--- unfold[x, kernel_size, dilation, padding, stride]: each window of x
--- `[n, c, h, w]` (or `[c, h, w]`) as a column, `[n, c·taps, windows]`,
--- its numbers by channel and then tap (F.unfold, im2col)
fn unfold[x, kernel_size, dilation = 1, padding = 0, stride = 1]
    kernel = windows.each[kernel_size, 2, 'kernel_size']
    dl = windows.each[dilation, 2, 'dilation']
    p = windows.each[padding, 2, 'padding']
    st = windows.each[stride, 2, 'stride']
    given = windows.batch_of[x.shape, 2, 'unfold']
    at = windows.outs[given.sizes, kernel, st, windows.Pads[p, p], dl, 'unfold']
    t = windows.table[given.sizes, kernel, st, p, dl, at]
    count = shapes.product[at]
    rows = given.channels * shapes.product[kernel]
    pos = windows.columns[t, given.n, given.channels, shapes.product[given.sizes], 0, given.channels]
    v = concat[math.flatten[x], math.zeros[1]][math.flatten[math.flatten[pos][windows.channels_first[given.n, count, rows]]]]
    dims = [rows, count]
    if given.batched
        dims = [given.n, rows, count]
    return shapes.laid[v, dims]

--- fold[x, output_size, kernel_size, dilation, padding, stride]: columns
--- `[n, c·taps, windows]` (or `[c·taps, windows]`) added back into images
--- `[n, c, h, w]`, the numbers of overlapping windows added up in the
--- order PyTorch's col2im adds them (F.fold)
fn fold[x, output_size, kernel_size, dilation = 1, padding = 0, stride = 1]
    sizes = windows.each[output_size, 2, 'output_size']
    kernel = windows.each[kernel_size, 2, 'kernel_size']
    dl = windows.each[dilation, 2, 'dilation']
    p = windows.each[padding, 2, 'padding']
    st = windows.each[stride, 2, 'stride']
    dims = x.shape
    if len[dims] ne 2 and len[dims] ne 3
        halt['fold: x takes 2 or 3 axes ([n,] c·taps, windows), and has `len[dims]`']
    n = 1
    rows = dims[0]
    count = dims[1]
    if len[dims] eq 3
        n = dims[0]
        rows = dims[1]
        count = dims[2]
    taps = shapes.product[kernel]
    if rows % taps ne 0
        halt['fold: expected size of input\'s dimension 1 to be divisible by the product of kernel_size, but got input.size(1)=`rows` and kernel_size=`str[kernel]`']
    c = rows / taps
    at = windows.outs[sizes, kernel, st, windows.Pads[p, p], dl, 'fold']
    if shapes.product[at] ne count
        halt['fold: given output_size, kernel_size, dilation, padding and stride, the input\'s last axis should hold `shapes.product[at]` windows, and holds `count`']
    t = windows.table[sizes, kernel, st, p, dl, at]
    f = windows.folded[t, shapes.product[sizes], n, c, rows * count, taps * count, 1, count, n * rows * count]
    v = _summed[concat[math.flatten[x], math.zeros[1]], f]
    out = [c, sizes[0], sizes[1]]
    if len[dims] eq 3
        out = [n, c, sizes[0], sizes[1]]
    return shapes.laid[v, out]

--- the poolings: windows over each plane, the largest number of a window,
--- its mean, its p-norm --------------------------------------------------------

--- pooled_sizes[sizes, kernel, stride, padding, dilation, ceil_mode, what]:
--- how many windows a pooling makes along each axis, as PyTorch counts
--- them — with ceil_mode a last part window too, unless it would start
--- past the input and its padding
fn pooled_sizes[sizes, kernel, stride, padding, dilation, ceil_mode, what]
    out = []
    for j in range[len[sizes]]
        reach = sizes[j] + 2 * padding[j] - dilation[j] * (kernel[j] - 1) - 1
        if reach lt 0
            halt['`what`: the window (`kernel[j]` taps, dilated `dilation[j]`) is larger than the input padded (`sizes[j] + 2 * padding[j]`) along axis `j`']
        if ceil_mode
            reach = reach + stride[j] - 1
        o = reach / stride[j] + 1
        if ceil_mode and (o - 1) * stride[j] gte sizes[j] + padding[j]
            o = o - 1
        out = push[out, o]
    return out

--- pool_stride[stride, kernel]: a pooling's strides, 0 the kernel's size
--- (PyTorch's stride=None)
fn pool_stride[stride, kernel]
    out = []
    for j in range[len[kernel]]
        s = stride[j]
        if s eq 0
            s = kernel[j]
        out = push[out, s]
    return out

fn _pool_checks[kernel, stride, padding, dilation, what]
    for j in range[len[kernel]]
        if kernel[j] lt 1 or stride[j] lt 1 or dilation[j] lt 1
            halt['`what`: kernel_size, stride and dilation are 1 or more, and got `kernel[j]`, `stride[j]` and `dilation[j]`']
        if padding[j] lt 0 or padding[j] gt ((kernel[j] - 1) * dilation[j] + 1) / 2
            halt['`what`: pad should be at most half of effective kernel size, but got pad=`padding[j]`, kernel_size=`kernel[j]` and dilation=`dilation[j]`']

--- max_pool1d[x, kernel_size, stride, padding, dilation, ceil_mode]: the
--- largest number of each window of each plane of x `[n, c, l]` (or `[c,
--- l]`), padding read as −∞ (F.max_pool1d); max_pool2d and max_pool3d
--- alike. stride 0 is the kernel's size; the options are an int or one per
--- spatial axis. A window's gradient goes to its first largest number,
--- as PyTorch's
fn max_pool1d[x, kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool[x, 1, kernel_size, stride, padding, dilation, ceil_mode, 'max_pool1d']

fn max_pool2d[x, kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool[x, 2, kernel_size, stride, padding, dilation, ceil_mode, 'max_pool2d']

fn max_pool3d[x, kernel_size, stride = 0, padding = 0, dilation = 1, ceil_mode = false]
    return _max_pool[x, 3, kernel_size, stride, padding, dilation, ceil_mode, 'max_pool3d']

fn _max_pool[x, d, kernel_size, stride, padding, dilation, ceil_mode, what]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = pool_stride[windows.each[stride, d, 'stride'], kernel]
    p = windows.each[padding, d, 'padding']
    dl = windows.each[dilation, d, 'dilation']
    given = windows.planes_of[x.shape, d, what]
    v = max_pool_flat[math.flatten[x], given.count, given.sizes, kernel, st, p, dl, ceil_mode, what]
    return shapes.laid[v, concat[given.lead, pooled_sizes[given.sizes, kernel, st, p, dl, ceil_mode, what]]]

--- max_pool_flat[v, planes, sizes, kernel, stride, padding, dilation,
--- ceil_mode, what]: max pooling of `planes` planes of `sizes` laid flat
fn max_pool_flat[v, planes, sizes, kernel, stride, padding, dilation, ceil_mode, what]
    _pool_checks[kernel, stride, padding, dilation, what]
    at = pooled_sizes[sizes, kernel, stride, padding, dilation, ceil_mode, what]
    t = windows.table[sizes, kernel, stride, padding, dilation, at]
    return _largest[concat[v, tensor[[-inf]]], windows.pooled[t, planes, shapes.product[sizes]]]

--- avg_pool1d[x, kernel_size, stride, padding, ceil_mode,
--- count_include_pad]: the mean of each window of each plane (F.avg_pool1d):
--- the window's numbers added in order and divided by its size — with its
--- padding where count_include_pad, without where not — or by
--- divisor_override (avg_pool2d and avg_pool3d take one). stride 0 is
--- the kernel's size
fn avg_pool1d[x, kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true]
    return _avg_pool[x, 1, kernel_size, stride, padding, ceil_mode, count_include_pad, 0, 'avg_pool1d']

fn avg_pool2d[x, kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true, divisor_override = 0]
    return _avg_pool[x, 2, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override, 'avg_pool2d']

fn avg_pool3d[x, kernel_size, stride = 0, padding = 0, ceil_mode = false, count_include_pad = true, divisor_override = 0]
    return _avg_pool[x, 3, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override, 'avg_pool3d']

fn _avg_pool[x, d, kernel_size, stride, padding, ceil_mode, count_include_pad, divisor_override, what]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = pool_stride[windows.each[stride, d, 'stride'], kernel]
    p = windows.each[padding, d, 'padding']
    given = windows.planes_of[x.shape, d, what]
    v = avg_pool_flat[math.flatten[x], given.count, given.sizes, kernel, st, p, ceil_mode, count_include_pad, divisor_override, what]
    return shapes.laid[v, concat[given.lead, pooled_sizes[given.sizes, kernel, st, p, windows.each[1, d, what], ceil_mode, what]]]

--- avg_pool_flat[v, planes, sizes, kernel, stride, padding, ceil_mode,
--- count_include_pad, divisor_override, what]: average pooling laid flat
fn avg_pool_flat[v, planes, sizes, kernel, stride, padding, ceil_mode, count_include_pad, divisor_override, what]
    undilated = windows.each[1, len[sizes], what]
    _pool_checks[kernel, stride, padding, undilated, what]
    at = pooled_sizes[sizes, kernel, stride, padding, undilated, ceil_mode, what]
    t = windows.table[sizes, kernel, stride, padding, undilated, at]
    sums = _summed[concat[v, math.zeros[1]], windows.pooled[t, planes, shapes.product[sizes]]]
    return sums ./ windows.tiled[windows.divisors[sizes, kernel, stride, padding, at, count_include_pad, divisor_override], planes]

--- adaptive_avg_pool1d[x, output_size]: each plane cut into output_size
--- windows as even as whole numbers allow — window i from ⌊i·l/o⌋ to
--- ⌈(i + 1)·l/o⌉ — and each window's mean (F.adaptive_avg_pool1d), divided
--- by its size along each axis in turn as PyTorch divides;
--- adaptive_avg_pool2d and adaptive_avg_pool3d alike, and the
--- adaptive_max_pool forms the largest number of each window
fn adaptive_avg_pool1d[x, output_size]
    return _adaptive[x, 1, output_size, 'avg', 'adaptive_avg_pool1d']

fn adaptive_avg_pool2d[x, output_size]
    return _adaptive[x, 2, output_size, 'avg', 'adaptive_avg_pool2d']

fn adaptive_avg_pool3d[x, output_size]
    return _adaptive[x, 3, output_size, 'avg', 'adaptive_avg_pool3d']

fn adaptive_max_pool1d[x, output_size]
    return _adaptive[x, 1, output_size, 'max', 'adaptive_max_pool1d']

fn adaptive_max_pool2d[x, output_size]
    return _adaptive[x, 2, output_size, 'max', 'adaptive_max_pool2d']

fn adaptive_max_pool3d[x, output_size]
    return _adaptive[x, 3, output_size, 'max', 'adaptive_max_pool3d']

fn _adaptive[x, d, output_size, how, what]
    at = windows.each[output_size, d, 'output_size']
    given = windows.planes_of[x.shape, d, what]
    return shapes.laid[adaptive_flat[math.flatten[x], given.count, given.sizes, at, how], concat[given.lead, at]]

--- adaptive_flat[v, planes, sizes, at, how]: adaptive pooling laid flat,
--- `how` 'avg' or 'max'
fn adaptive_flat[v, planes, sizes, at, how]
    a = windows.adaptive[sizes, at]
    pos = windows.pooled[a.table, planes, shapes.product[sizes]]
    if how eq 'max'
        return _largest[concat[v, tensor[[-inf]]], pos]
    out = _summed[concat[v, math.zeros[1]], pos]
    for s in a.lengths
        out = out ./ windows.tiled[s, planes]
    return out

--- lp_pool1d[x, norm_type, kernel_size, stride, ceil_mode]: the p-norm of
--- each window, (Σ xᵖ)^(1/p), as PyTorch computes it: the mean of xᵖ times
--- the window's size, its sign kept, to the power 1/p (F.lp_pool1d);
--- lp_pool2d and lp_pool3d alike
fn lp_pool1d[x, norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool[x, 1, norm_type, kernel_size, stride, ceil_mode, 'lp_pool1d']

fn lp_pool2d[x, norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool[x, 2, norm_type, kernel_size, stride, ceil_mode, 'lp_pool2d']

fn lp_pool3d[x, norm_type, kernel_size, stride = 0, ceil_mode = false]
    return _lp_pool[x, 3, norm_type, kernel_size, stride, ceil_mode, 'lp_pool3d']

fn _lp_pool[x, d, norm_type, kernel_size, stride, ceil_mode, what]
    kernel = windows.each[kernel_size, d, 'kernel_size']
    st = pool_stride[windows.each[stride, d, 'stride'], kernel]
    given = windows.planes_of[x.shape, d, what]
    v = lp_pool_flat[math.flatten[x], given.count, given.sizes, norm_type, kernel, st, ceil_mode, what]
    return shapes.laid[v, concat[given.lead, pooled_sizes[given.sizes, kernel, st, windows.each[0, d, what], windows.each[1, d, what], ceil_mode, what]]]

--- lp_pool_flat[v, planes, sizes, norm_type, kernel, stride, ceil_mode,
--- what]: power-average pooling laid flat
fn lp_pool_flat[v, planes, sizes, norm_type, kernel, stride, ceil_mode, what]
    p = float[norm_type]
    powered = v .^ p
    if p eq 2.0
        powered = v .* v
    out = avg_pool_flat[powered, planes, sizes, kernel, stride, windows.each[0, len[sizes], what], ceil_mode, true, 0, what]
    kept = sign[out] .* relu[abs[out]] * float[shapes.product[kernel]]
    if p eq 2.0
        return sqrt[kept]
    return kept .^ (1.0 / p)

--- pad[x, widths, mode, value]: x with numbers added before and after its
--- last axes (F.pad): widths names them from the last axis — before and
--- after it, then before and after the axis before it — and a negative one
--- cuts numbers off (mode 'constant'). 'constant' adds `value`, 'reflect'
--- mirrors about the edge, 'replicate' repeats it and 'circular' wraps
--- around
fn pad[x, widths, mode = 'constant', value = 0.0]
    w = _whole[widths]
    if mode ne 'constant' and (len[x.shape] lt 2 or len[w] / 2 gt len[x.shape] - 1)
        halt['pad: mode `mode` pads an input of 2 to 5 axes along its last 1 to 3, and was given `len[w]` widths for `len[x.shape]` axes']
    pos = windows.padded[x.shape, w, mode, 'pad']
    return shapes.laid[concat[math.flatten[x], tensor[[value]]][pos], windows.padded_dims[x.shape, w]]

--- pixel_shuffle[x, r]: `[…, c·r², h, w]` laid as `[…, c, h·r, w·r]`, each
--- r² channels a block of r × r numbers (F.pixel_shuffle)
fn pixel_shuffle[x, r]
    dims = x.shape
    k = len[dims]
    if k lt 3
        halt['pixel_shuffle expects input to have at least 3 dimensions, but got input with `k` dimension(s)']
    c2 = dims[k - 3]
    h = dims[k - 2]
    w = dims[k - 1]
    if r lt 1 or c2 % (r * r) ne 0
        halt['pixel_shuffle expects its input\'s \'channel\' dimension to be divisible by the square of upscale_factor, but input.size(-3)=`c2` is not divisible by `r * r`']
    c = c2 / (r * r)
    pos = []
    for ch in range[c]
        for y in range[h * r]
            for z in range[w * r]
                pos = push[pos, float[((ch * r * r + (y % r) * r + z % r) * h + y / r) * w + z / r]]
    lead = shapes.product[slice[dims, 0, k - 3]]
    at = math.flatten[reshape[tensor[range[lead]] * float[c2 * h * w], lead, 1] + reshape[tensor[pos], 1, len[pos]]]
    return shapes.laid[math.flatten[x][at], concat[slice[dims, 0, k - 3], [c, h * r, w * r]]]

--- pixel_unshuffle[x, r]: `[…, c, h·r, w·r]` laid as `[…, c·r², h, w]`,
--- pixel_shuffle undone (F.pixel_unshuffle)
fn pixel_unshuffle[x, r]
    dims = x.shape
    k = len[dims]
    if k lt 3
        halt['pixel_unshuffle expects input to have at least 3 dimensions, but got input with `k` dimension(s)']
    c = dims[k - 3]
    hr = dims[k - 2]
    wr = dims[k - 1]
    if r lt 1 or hr % r ne 0 or wr % r ne 0
        halt['pixel_unshuffle expects height and width to be divisible by downscale_factor, but got `hr` and `wr` and `r`']
    h = hr / r
    w = wr / r
    pos = []
    for ch in range[c]
        for i in range[r]
            for j in range[r]
                for y in range[h]
                    for z in range[w]
                        pos = push[pos, float[(ch * hr + y * r + i) * wr + z * r + j]]
    lead = shapes.product[slice[dims, 0, k - 3]]
    at = math.flatten[reshape[tensor[range[lead]] * float[c * hr * wr], lead, 1] + reshape[tensor[pos], 1, len[pos]]]
    return shapes.laid[math.flatten[x][at], concat[slice[dims, 0, k - 3], [c * r * r, h, w]]]

--- channel_shuffle[x, groups]: the channels of x `[n, c, …]` dealt from
--- `groups` groups in turn: channel i of the answer is channel (i mod g)
--- · (c / g) + ⌊i / g⌋ (F.channel_shuffle)
fn channel_shuffle[x, groups]
    dims = x.shape
    if len[dims] lt 3
        halt['channel_shuffle expects input to have at least 3 dimensions, but got input with `len[dims]` dimension(s)']
    c = dims[1]
    if groups lt 1 or c % groups ne 0
        halt['Number of channels must be divisible by groups. Got `c` channels and `groups` groups.']
    per = c / groups
    inner = shapes.product[slice[dims, 2, len[dims]]]
    pos = []
    for i in range[c]
        src = (i % groups) * per + i / groups
        for q in range[inner]
            pos = push[pos, float[src * inner + q]]
    at = math.flatten[reshape[tensor[range[dims[0]]] * float[c * inner], dims[0], 1] + reshape[tensor[pos], 1, len[pos]]]
    return shapes.laid[math.flatten[x][at], dims]

--- interpolate[x, size, scale_factor, mode, align_corners]: x `[n, c, …]`
--- resampled to `size` along its spatial axes, or to their sizes times
--- scale_factor, floored (F.interpolate). mode 'nearest' and
--- 'nearest-exact' read the number at the position PyTorch computes in
--- single precision; 'linear', 'bilinear' and 'trilinear' (one, two and
--- three spatial axes) weigh the two numbers about it along each axis, the
--- corners aligned where align_corners; 'area' is adaptive average pooling
fn interpolate[x, size = 0, scale_factor = 0.0, mode = 'nearest', align_corners = false]
    dims = x.shape
    d = len[dims] - 2
    if d lt 1 or d gt 3
        halt['interpolate: x takes 3 to 5 axes [n, c, …], and has `len[dims]`']
    sizes = slice[dims, 2, len[dims]]
    scales = []
    at = []
    if str[size] ne '0'
        at = windows.each[size, d, 'size']
        for j in range[d]
            scales = push[scales, 0.0]
    else
        given = math.flatten[tensor[[scale_factor]]]
        if len[given] ne 1 and len[given] ne d
            halt['interpolate: scale_factor takes one number or `d`, and was given `len[given]`']
        for j in range[d]
            s = given[0]
            if len[given] eq d
                s = given[j]
            if s lte 0.0
                halt['interpolate: either size or scale_factor should be defined, and scale_factor is `s`']
            scales = push[scales, s]
            at = push[at, int[floor[float[sizes[j]] * s]]]
    planes = dims[0] * dims[1]
    v = math.flatten[x]
    if mode eq 'area'
        return shapes.laid[adaptive_flat[v, planes, sizes, at, 'avg'], concat[slice[dims, 0, 2], at]]
    if mode eq 'nearest' or mode eq 'nearest-exact'
        return shapes.laid[math.flatten[v[windows.pooled[_nearest_table[sizes, at, scales, mode], planes, shapes.product[sizes]]]], concat[slice[dims, 0, 2], at]]
    if not ((mode eq 'linear' and d eq 1) or (mode eq 'bilinear' and d eq 2) or (mode eq 'trilinear' and d eq 3))
        halt['interpolate: mode `mode` is none of nearest, nearest-exact, area, and the linear mode of `d` spatial axes (linear, bilinear, trilinear)']
    return shapes.laid[_linear_resampled[v, planes, sizes, at, scales, align_corners], concat[slice[dims, 0, 2], at]]

--- the scale PyTorch reads positions by: 1 / the scale factor given, or
--- the sizes' ratio
fn _ratio[s, given, at]
    if s gt 0.0
        return 1.0 / s
    return float[given] / float[at]

--- the position nearest mode reads along an axis, as PyTorch's float
--- arithmetic finds it
fn _nearest_at[o, given, at, s, mode]
    if mode eq 'nearest'
        if at eq given
            return o
        if at eq 2 * given
            return o / 2
        scale = single.of[_ratio[s, given, at]]
        return min[int[floor[single.of[float[o] * scale]]], given - 1]
    scale = single.of[_ratio[s, given, at]]
    return min[int[floor[single.of[(float[o] + 0.5) * scale]]], given - 1]

fn _nearest_table[sizes, at, scales, mode]
    d = len[sizes]
    count = shapes.product[at]
    out = []
    for o in range[count]
        rest = o
        pos = 0
        place = 1
        for j in range[d]
            a = d - 1 - j
            here = rest % at[a]
            rest = rest / at[a]
            pos = pos + _nearest_at[here, sizes[a], at[a], scales[a], mode] * place
            place = place * sizes[a]
        out = push[out, float[pos]]
    return reshape[tensor[out], count, 1]

--- linear resampling: along each axis the source position, the index
--- below it and the one after (the same at the edge), and their weights;
--- the corners weighed from the last axis out, as PyTorch nests them:
--- h0·(w0·x00 + w1·x01) + h1·(w0·x10 + w1·x11)
fn _linear_resampled[v, planes, sizes, at, scales, align_corners]
    d = len[sizes]
    count = shapes.product[at]
    corners = 1
    for j in range[d]
        corners = corners * 2
    lows = []
    nexts = []
    highs = []
    for j in range[d]
        scale = _ratio[scales[j], sizes[j], at[j]]
        if align_corners
            scale = 0.0
            if at[j] gt 1
                scale = float[sizes[j] - 1] / float[at[j] - 1]
        low = []
        step = []
        w1 = []
        for o in range[at[j]]
            src = scale * float[o]
            if not align_corners
                src = max[scale * (float[o] + 0.5) - 0.5, 0.0]
            i = min[int[floor[single.of[src]]], sizes[j] - 1]
            lam = min[max[src - float[i], 0.0], 1.0]
            low = push[low, i]
            off = 0
            if i lt sizes[j] - 1
                off = 1
            step = push[step, off]
            w1 = push[w1, lam]
        lows = concat[lows, low]
        nexts = concat[nexts, step]
        highs = concat[highs, w1]
    --- each output position's corners' positions in its plane
    pos = []
    for o in range[count]
        for corner in range[corners]
            rest = o
            pick = corner
            p = 0
            place = 1
            start = len[lows]
            for j in range[d]
                a = d - 1 - j
                here = rest % at[a]
                rest = rest / at[a]
                start = start - at[a]
                i = lows[start + here]
                if pick % 2 eq 1
                    i = i + nexts[start + here]
                pick = pick / 2
                p = p + i * place
                place = place * sizes[a]
            pos = push[pos, float[p]]
    where_read = windows.pooled[reshape[tensor[pos], count, corners], planes, shapes.product[sizes]]
    at_corners = reshape[v[where_read], where_read.shape[0], corners]
    --- the corners, as columns, weighed from the last axis
    weighed = []
    for corner in range[corners]
        weighed = push[weighed, _column[at_corners, corner]]
    start = len[lows]
    for j in range[d]
        a = d - 1 - j
        start = start - at[a]
        w = windows.tiled[_spread[tensor[slice[highs, start, start + at[a]]], at, a], planes]
        joined = []
        for k in range[len[weighed] / 2]
            joined = push[joined, (1.0 - w) .* weighed[2 * k] + w .* weighed[2 * k + 1]]
        weighed = joined
    return weighed[0]

--- a matrix's column c as a vector
fn _column[mat, c]
    rows = mat.shape[0]
    return math.flatten[math.flatten[mat][tensor[range[rows]] * float[mat.shape[1]] + float[c]]]

--- a vector of axis a's numbers, one for each position of a box of
--- sizes `at` by its coordinate along a
fn _spread[w, at, a]
    count = shapes.product[at]
    inner = shapes.product[slice[at, a + 1, len[at]]]
    pos = []
    for o in range[count]
        pos = push[pos, float[(o / inner) % at[a]]]
    return math.flatten[w[tensor[pos]]]

--- the recurrent cells ----------------------------------------------------------

--- a step's state: the hidden state and the cell state (an LSTM's)
struct State [h, c]

--- a step's gates: rows · wᵀ + b, the rows of a matrix or one vector
fn _gates[rows, w, b]
    ins = w.shape[1]
    return reshape[rows, len[math.flatten[rows]] / ins, ins] * transpose[w] + b

--- a matrix's columns from `start`, `count` of them
fn _cols[mat, start, count]
    rows = mat.shape[0]
    width = mat.shape[1]
    return reshape[math.flatten[mat][reshape[tensor[range[rows]] * float[width], rows, 1] + reshape[tensor[range[start, start + count]], 1, count]], rows, count]

--- rnn_tanh_cell[x, h, w_ih, w_hh, b_ih, b_hh]: one step of an Elman
--- network, tanh(h · w_hhᵀ + b_hh + x · w_ihᵀ + b_ih) — x `[n, ins]`, h
--- `[n, hidden]`, the weights `[hidden, ins]` and `[hidden, hidden]`
--- (torch.rnn_tanh_cell, nn.RNNCell); rnn_relu_cell with relu
fn rnn_tanh_cell[x, h, w_ih, w_hh, b_ih = 0.0, b_hh = 0.0]
    return math.tanh[_gates[h, w_hh, b_hh] + _gates[x, w_ih, b_ih]]

fn rnn_relu_cell[x, h, w_ih, w_hh, b_ih = 0.0, b_hh = 0.0]
    return relu[_gates[h, w_hh, b_hh] + _gates[x, w_ih, b_ih]]

--- lstm_cell[x, h, c, w_ih, w_hh, b_ih, b_hh]: one step of a long
--- short-term memory (torch.lstm_cell, nn.LSTMCell): the gates i, f, g, o
--- of h · w_hhᵀ + b_hh + x · w_ihᵀ + b_ih, then c′ = f·c + i·g and h′ =
--- o·tanh(c′); the weights `[4·hidden, ins]` and `[4·hidden, hidden]`
fn lstm_cell[x, h, c, w_ih, w_hh, b_ih = 0.0, b_hh = 0.0]
    hidden = w_hh.shape[1]
    gates = _gates[h, w_hh, b_hh] + _gates[x, w_ih, b_ih]
    return lstm_step[gates, reshape[c, len[math.flatten[c]] / hidden, hidden]]

--- lstm_step[gates, c]: an LSTM's step from its gates `[n, 4·hidden]` and
--- its cell state `[n, hidden]`
fn lstm_step[gates, c]
    hidden = gates.shape[1] / 4
    i = sigmoid[_cols[gates, 0, hidden]]
    f = sigmoid[_cols[gates, hidden, hidden]]
    g = math.tanh[_cols[gates, 2 * hidden, hidden]]
    o = sigmoid[_cols[gates, 3 * hidden, hidden]]
    kept = f .* c + i .* g
    return State[o .* math.tanh[kept], kept]

--- gru_cell[x, h, w_ih, w_hh, b_ih, b_hh]: one step of a gated recurrent
--- unit (torch.gru_cell, nn.GRUCell): r and z the sigmoids of h's and x's
--- gates added, n = tanh(x's + r·h's), h′ = (h − n)·z + n; the weights
--- `[3·hidden, ins]` and `[3·hidden, hidden]`
fn gru_cell[x, h, w_ih, w_hh, b_ih = 0.0, b_hh = 0.0]
    hidden = w_hh.shape[1]
    return gru_step[_gates[x, w_ih, b_ih], _gates[h, w_hh, b_hh], reshape[h, len[math.flatten[h]] / hidden, hidden]]

--- gru_step[gi, gh, h]: a GRU's step from x's gates and h's
fn gru_step[gi, gh, h]
    hidden = gh.shape[1] / 3
    r = sigmoid[_cols[gh, 0, hidden] + _cols[gi, 0, hidden]]
    z = sigmoid[_cols[gh, hidden, hidden] + _cols[gi, hidden, hidden]]
    n = math.tanh[_cols[gi, 2 * hidden, hidden] + _cols[gh, 2 * hidden, hidden] .* r]
    return (h - n) .* z + n

--- attention ---------------------------------------------------------------------

--- an attention's answer: its output and, where asked for, its weights
--- (no numbers otherwise)
struct Attention [output, weights]

--- causal_mask[l, s]: the float mask of a causal attention, 0 on and
--- below the diagonal and −∞ above it (PyTorch's lower triangle as a float
--- mask; nn.Transformer.generate_square_subsequent_mask of l·l)
fn causal_mask[l, s]
    out = []
    for i in range[l]
        for j in range[s]
            if j gt i
                out = push[out, 0.0 - inf]
            else
                out = push[out, 0.0]
    return reshape[tensor[out], l, s]

--- scaled_dot_product_attention[q, k, v, attn_mask, dropout_p, is_causal,
--- scale, noise]: softmax(q · kᵀ · scale + mask) · v over the last two
--- axes of q `[…, L, E]`, k `[…, S, E]` and v `[…, S, Ev]`, the axes
--- before them a batch (F.scaled_dot_product_attention). The mask is a
--- float mask, added — 0 where a position takes part, −∞ where it does
--- not — of `[L, S]` or of any sizes that broadcast to `[…, L, S]`;
--- is_causal masks what lies above the diagonal, and takes no mask beside
--- it; the scale is 1/√E unless given. With dropout_p above 0 the weights
--- are dropped as F.dropout drops them, by noise of their size `[…, L, S]`
fn scaled_dot_product_attention[q, k, v, attn_mask = 0.0, dropout_p = 0.0, is_causal = false, scale = 0.0, noise = -1.0]
    qd = q.shape
    kd = k.shape
    vd = v.shape
    r = len[qd]
    if r lt 2 or len[kd] ne r or len[vd] ne r
        halt['scaled_dot_product_attention: q, k and v take one rank of 2 or more, and have `r`, `len[kd]` and `len[vd]`']
    lead = slice[qd, 0, r - 2]
    if not (slice[kd, 0, r - 2] eq lead and slice[vd, 0, r - 2] eq lead)
        halt['scaled_dot_product_attention: q, k and v take one batch, and are `str[qd]`, `str[kd]` and `str[vd]`']
    l = qd[r - 2]
    emb = qd[r - 1]
    s = kd[r - 2]
    ev = vd[r - 1]
    if kd[r - 1] ne emb or vd[r - 2] ne s
        halt['scaled_dot_product_attention: k `str[kd]` and v `str[vd]` do not fit q `str[qd]`']
    by = scale
    if by eq 0.0
        by = 1.0 / sqrt[float[emb]]
    count = shapes.product[lead]
    mask = _attention_mask[attn_mask, concat[lead, [l, s]], is_causal, 'scaled_dot_product_attention']
    keep = math.zeros[0]
    if dropout_p gt 0.0 and dropout_p lt 1.0
        keep = noise_of[noise, count * l * s, 'scaled_dot_product_attention']
    weighed = _attended[math.flatten[q], math.flatten[k], math.flatten[v], mask, count, l, s, emb, ev, by, dropout_p, keep]
    return shapes.laid[weighed.output, concat[lead, [l, ev]]]

--- a float mask broadcast to `dims` (`[…, L, S]`), flat: zeros where none
--- is given, the causal triangle where asked
fn _attention_mask[attn_mask, dims, is_causal, what]
    given = math.zeros[1] + attn_mask
    gv = math.flatten[given]
    r = len[dims]
    l = dims[r - 2]
    s = dims[r - 1]
    count = shapes.product[dims] / (l * s)
    if is_causal
        if len[gv] ne 1 or gv[0] ne 0.0
            halt['`what`: an explicit attn_mask is not set when is_causal is true']
        return windows.tiled[math.flatten[causal_mask[l, s]], count]
    if len[gv] eq 1
        return math.zeros[shapes.product[dims]] + gv[0]
    if len[gv] eq l * s
        return windows.tiled[gv, count]
    return _broadcast[gv, given.shape, dims, what]

--- given `gdims` broadcast to `dims`, flat: the axes aligned at the end,
--- each of given's 1 or the size it meets
fn _broadcast[given, gdims, dims, what]
    r = len[dims]
    k = len[gdims]
    if k gt r
        halt['`what`: the mask `str[gdims]` does not broadcast to `str[dims]`']
    strides = []
    for a in range[r]
        strides = push[strides, 0]
    step = 1
    for j in range[k]
        a = k - 1 - j
        o = r - 1 - j
        if gdims[a] eq dims[o]
            strides[o] = step
        else
            if gdims[a] ne 1
                halt['`what`: the mask `str[gdims]` does not broadcast to `str[dims]`']
        step = step * gdims[a]
    pos = []
    for t in range[shapes.product[dims]]
        rest = t
        at = 0
        for j in range[r]
            a = r - 1 - j
            at = at + (rest % dims[a]) * strides[a]
            rest = rest / dims[a]
        pos = push[pos, float[at]]
    return given[tensor[pos]]

--- each of `count` attentions over flat q `[count, l, e]`, k `[count, s,
--- e]` and v `[count, s, ev]` with the flat mask `[count, l, s]`: the
--- scores (q · by) · kᵀ + mask, their softmax along each row, dropped by
--- `keep` where p is above 0, then the weights · v (`Attention`, flat)
fn _attended[qv, kv, vv, mask, count, l, s, emb, ev, by, p, keep]
    outs = []
    ws = []
    for b in range[count]
        qb = reshape[slice[qv, b * l * emb, (b + 1) * l * emb], l, emb]
        kb = reshape[slice[kv, b * s * emb, (b + 1) * s * emb], s, emb]
        vb = reshape[slice[vv, b * s * ev, (b + 1) * s * ev], s, ev]
        scores = (qb * by) * transpose[kb] + reshape[slice[mask, b * l * s, (b + 1) * l * s], l, s]
        w = softmax[scores, 1]
        if p gt 0.0
            w = reshape[math.flatten[dropout[w, p, true, slice[keep, b * l * s, (b + 1) * l * s]]], l, s]
        outs = push[outs, math.flatten[w * vb]]
        ws = push[ws, math.flatten[w]]
    return Attention[math.flatten[math.stack[outs]], math.flatten[math.stack[ws]]]

--- the heads of x `[rows·n, h·hd]` (a row for each position and batch),
--- flat as `[n·h, rows, hd]`: PyTorch's view(rows, n·h, hd).transpose(0, 1)
fn _heads[x, rows, n, h, hd]
    emb = h * hd
    firsts = []
    for b in range[n * h]
        firsts = push[firsts, float[(b / h) * emb + (b % h) * hd]]
    pos = reshape[tensor[firsts], n * h, 1, 1] + reshape[tensor[range[rows]] * float[n * emb], 1, rows, 1] + reshape[tensor[range[hd]], 1, 1, hd]
    return math.flatten[x][math.flatten[pos]]

--- the heads' outputs `[n·h, rows, hd]`, flat, joined back as rows of
--- each position and batch `[rows·n, h·hd]` (transpose(0, 1) and view)
fn _joined_heads[o, rows, n, h, hd]
    firsts = []
    for i in range[rows]
        for nb in range[n]
            firsts = push[firsts, float[nb * h * rows * hd + i * hd]]
    pos = reshape[tensor[firsts], rows * n, 1, 1] + reshape[tensor[range[h]] * float[rows * hd], 1, h, 1] + reshape[tensor[range[hd]], 1, 1, hd]
    return reshape[o[math.flatten[pos]], rows * n, h * hd]

--- rows `[s·n, e]` (each position's, batch by batch) with one position
--- more: `extra` (e numbers) for every batch
fn _with_row[x, n, emb, extra]
    return concat[x, reshape[windows.tiled[extra, n], n, emb]]

--- x laid `[rows, cols]`, flat, with k zeros after each row
fn _padded[x, rows, cols, k]
    return math.flatten[concat[reshape[x, rows, cols], math.zeros[rows, k], axis = 1]]

--- a padding mask `[n, s]`, flat, as each head's rows meet it: `[n, h, l,
--- s]` (PyTorch's view(n, 1, 1, s).expand(-1, h, -1, -1))
fn _padding_rows[kpm, n, h, l, s]
    out = math.zeros[0]
    for nb in range[n]
        out = concat[out, windows.tiled[slice[kpm, nb * s, (nb + 1) * s], h * l]]
    return out

--- weights `[n, h, l·s]`, flat, averaged over the heads: their sum, then
--- divided (PyTorch's mean, a sum and a division)
fn _head_mean[w, n, h, per]
    out = math.zeros[0]
    for nb in range[n]
        acc = slice[w, nb * h * per, nb * h * per + per]
        for hh in range[1, h]
            acc = acc + slice[w, (nb * h + hh) * per, (nb * h + hh + 1) * per]
        out = concat[out, acc / float[h]]
    return out

--- an attention layer's parameters, flat, PyTorch's (a vector of no
--- numbers where one is none): the packed in_proj_weight `[3E, E]` or the
--- separate q_, k_ and v_proj_weight, in_proj_bias, bias_k and bias_v (E
--- numbers each), and out_proj's weight and bias
struct Projections [in_w, in_b, q_w, k_w, v_w, bias_k, bias_v, out_w, out_b]

--- an attention's masks, flat: attn_mask's numbers (none where none is
--- given), how many attentions they mask — 1 for `[L, S]`, N·heads for
--- `[N·heads, L, S]` — and its number of axes (0 for none), and the padding
--- mask's numbers `[N, S]` (none where none is given)
struct Masks [attention, groups, axes, padding]

--- masks_of[attn_mask, key_padding_mask, l, s, n, heads, is_causal]: an
--- attention's float masks checked against l queries of s keys for n items
--- as PyTorch's multi_head_attention_forward checks them (`Masks`); a mask
--- of one number is none, and is_causal takes an attn_mask beside it
fn masks_of[attn_mask, key_padding_mask, l, s, n, heads, is_causal]
    am = math.zeros[1] + attn_mask
    amv = math.flatten[am]
    ad = am.shape
    groups = 1
    axes = len[ad]
    if len[amv] eq 1
        if is_causal
            halt['Need attn_mask if specifying the is_causal hint. You may use the Transformer module method ‘generate_square_subsequent_mask’ to create this mask.']
        amv = math.zeros[0]
        axes = 0
    else
        if axes eq 3
            groups = n * heads
            if not (ad eq [n * heads, l, s])
                halt['The shape of the 3D attn_mask is `str[ad]`, but should be `str[[n * heads, l, s]]`.']
        else
            if axes ne 2
                halt['attn_mask’s dimension `axes` is not supported']
            if not (ad eq [l, s])
                halt['The shape of the 2D attn_mask is `str[ad]`, but should be `str[[l, s]]`.']
    kpm = math.flatten[math.zeros[1] + key_padding_mask]
    if len[kpm] eq 1
        kpm = math.zeros[0]
    else
        if len[kpm] ne n * s
            halt['expecting key_padding_mask shape of `str[[n, s]]`, but it holds `len[kpm]` numbers']
    return Masks[amv, groups, axes, kpm]

--- multi_head_flat[q, k, v, l, s, n, e, kdim, vdim, heads, pr, zero_attn,
--- p, masks, need_weights, average, is_causal, keep]: the attention of
--- multi_head_attention_forward on flat numbers, each laid time-major: the
--- queries q `[L, N, E]`, the keys k `[S, N, kdim]` and the values v `[S,
--- N, vdim]`, its parameters `pr` (`Projections`) and masks (`Masks`),
--- the weights dropped by `keep` where p is above 0. It answers the output
--- `[L, N, E]` and, where need_weights, the weights `[N, heads, L, S]`
--- (`[N, L, S]` averaged), flat (`Attention`); S counts bias_k's and the
--- zero attention's positions
fn multi_head_flat[q, k, v, l, s, n, emb, kdim, vdim, heads, pr, zero_attn, p, masks, need_weights, average, is_causal, keep]
    h = heads
    hd = emb / h
    --- the projections: a row for each position and batch
    wq = math.zeros[emb, emb]
    wk = math.zeros[emb, kdim]
    wv = math.zeros[emb, vdim]
    if len[pr.in_w] gt 0
        wq = reshape[slice[pr.in_w, 0, emb * emb], emb, emb]
        wk = reshape[slice[pr.in_w, emb * emb, 2 * emb * emb], emb, emb]
        wv = reshape[slice[pr.in_w, 2 * emb * emb, 3 * emb * emb], emb, emb]
    else
        wq = reshape[pr.q_w, emb, emb]
        wk = reshape[pr.k_w, emb, kdim]
        wv = reshape[pr.v_w, emb, vdim]
    bias = pr.in_b
    if len[bias] eq 0
        bias = math.zeros[3 * emb]
    qp = linear[reshape[q, l * n, emb], wq, slice[bias, 0, emb]]
    kp = linear[reshape[k, s * n, kdim], wk, slice[bias, emb, 2 * emb]]
    vp = linear[reshape[v, s * n, vdim], wv, slice[bias, 2 * emb, 3 * emb]]
    --- the masks, and bias_k and bias_v after the keys and values
    groups = masks.groups
    amv = masks.attention
    if len[amv] eq 0
        amv = math.zeros[l * s]
        groups = 1
    padded = len[masks.padding] gt 0
    kpm = masks.padding
    if not padded
        kpm = math.zeros[n * s]
    width = s
    if len[pr.bias_k] gt 0
        kp = _with_row[kp, n, emb, pr.bias_k]
        vp = _with_row[vp, n, emb, pr.bias_v]
        amv = _padded[amv, groups * l, width, 1]
        kpm = _padded[kpm, n, width, 1]
        width = width + 1
    --- the heads, `[N·heads, S, hd]`, and the zero attention after them
    qh = _heads[qp, l, n, h, hd]
    kh = _heads[kp, width, n, h, hd]
    vh = _heads[vp, width, n, h, hd]
    if zero_attn
        kh = _padded[kh, n * h, width * hd, hd]
        vh = _padded[vh, n * h, width * hd, hd]
        amv = _padded[amv, groups * l, width, 1]
        kpm = _padded[kpm, n, width, 1]
        width = width + 1
    --- each head's mask: the attention's, then its batch's padding; the
    --- causal triangle itself where PyTorch hands the hint on to its
    --- attention (no padding, no weights asked)
    joined_mask = windows.tiled[amv, (n * h) / groups]
    if padded
        joined_mask = joined_mask + _padding_rows[kpm, n, h, l, width]
    if is_causal and not padded and not need_weights
        joined_mask = windows.tiled[math.flatten[causal_mask[l, width]], n * h]
    weighed = _attended[qh, kh, vh, joined_mask, n * h, l, width, hd, hd, sqrt[1.0 / float[hd]], p, keep]
    ob = pr.out_b
    if len[ob] eq 0
        ob = math.zeros[emb]
    out = math.flatten[linear[_joined_heads[weighed.output, l, n, h, hd], reshape[pr.out_w, emb, emb], ob]]
    if not need_weights
        return Attention[out, math.zeros[0]]
    if average
        return Attention[out, _head_mean[weighed.weights, n, h, l * width]]
    return Attention[out, weighed.weights]

--- a parameter given, flat, or none: x where it holds `count` numbers
--- laid in `axes` axes or `count` above 1, no numbers otherwise
fn _given_or_none[x, count, axes]
    t = math.zeros[1] + x
    v = math.flatten[t]
    if len[v] eq count and (count gt 1 or len[t.shape] eq axes)
        return v
    return math.zeros[0]

--- multi_head_attention_forward[query, key, value, embed_dim_to_check,
--- num_heads, in_proj_weight, in_proj_bias, bias_k, bias_v, add_zero_attn,
--- dropout_p, out_proj_weight, out_proj_bias, …]: PyTorch's
--- F.multi_head_attention_forward. query `[L, N, E]`, key `[S, N, kdim]`
--- and value `[S, N, vdim]` (or `[L, E]`, … unbatched) are each projected
--- — by the packed in_proj_weight `[3E, E]`, or q_, k_ and v_proj_weight
--- where use_separate_proj_weight — and split into num_heads heads; each
--- head's weights are softmax(q · kᵀ / √(E/heads) + masks), its output
--- the weights · v, and the heads are joined and projected out. bias_k and
--- bias_v `[1, 1, E]` (0 for none) are appended to the keys and values,
--- add_zero_attn appends zeros after them. The masks are float masks,
--- added: attn_mask `[L, S]` or `[N·heads, L, S]`, key_padding_mask `[N,
--- S]` (`[S]` unbatched); is_causal is PyTorch's hint that attn_mask is
--- causal (without the weights or a padding mask, the causal triangle is
--- what attends, as PyTorch's). In training, dropout_p drops the weights
--- by noise of their size `[N·heads, L, S]`. It answers the output `[L, N,
--- E]` and, where need_weights, the weights: `[N, L, S]` averaged over the
--- heads, or `[N, heads, L, S]` (`Attention`)
fn multi_head_attention_forward[query, key, value, embed_dim_to_check, num_heads, in_proj_weight, in_proj_bias, bias_k, bias_v, add_zero_attn, dropout_p, out_proj_weight, out_proj_bias, training = true, key_padding_mask = 0.0, need_weights = true, attn_mask = 0.0, use_separate_proj_weight = false, q_proj_weight = 0.0, k_proj_weight = 0.0, v_proj_weight = 0.0, average_attn_weights = true, is_causal = false, noise = -1.0]
    qd = query.shape
    kd = key.shape
    vd = value.shape
    batched = len[qd] eq 3
    if batched
        if len[kd] ne 3 or len[vd] ne 3
            halt['For batched (3-D) ‘query’, expected ‘key’ and ‘value’ to be 3-D but found `len[kd]`-D and `len[vd]`-D tensors respectively']
    else
        if len[qd] ne 2
            halt['query should be unbatched 2D or batched 3D tensor but received `len[qd]`-D query tensor']
        if len[kd] ne 2 or len[vd] ne 2
            halt['For unbatched (2-D) ‘query’, expected ‘key’ and ‘value’ to be 2-D but found `len[kd]`-D and `len[vd]`-D tensors respectively']
    l = qd[0]
    n = 1
    if batched
        n = qd[1]
    emb = qd[len[qd] - 1]
    if emb ne embed_dim_to_check
        halt['was expecting embedding dimension of `embed_dim_to_check`, but got `emb`']
    h = num_heads
    if (emb / h) * h ne emb
        halt['embed_dim `emb` not divisible by num_heads `h`']
    s = kd[0]
    kdim = kd[len[kd] - 1]
    vdim = vd[len[vd] - 1]
    if not (slice[kd, 0, len[kd] - 1] eq slice[vd, 0, len[vd] - 1])
        halt['key shape `str[kd]` does not match value shape `str[vd]`']
    none = math.zeros[0]
    pr = Projections[none, math.flatten[math.zeros[3 * emb] + in_proj_bias], none, none, none, _given_or_none[bias_k, emb, 3], _given_or_none[bias_v, emb, 3], math.flatten[out_proj_weight], math.flatten[math.zeros[emb] + out_proj_bias]]
    if use_separate_proj_weight
        pr.q_w = math.flatten[math.zeros[1] + q_proj_weight]
        pr.k_w = math.flatten[math.zeros[1] + k_proj_weight]
        pr.v_w = math.flatten[math.zeros[1] + v_proj_weight]
        if len[pr.q_w] ne emb * emb or len[pr.k_w] ne emb * kdim or len[pr.v_w] ne emb * vdim
            halt['the separate projection weights take `str[[emb, emb]]`, `str[[emb, kdim]]` and `str[[emb, vdim]]`']
    else
        if kdim ne emb or vdim ne emb
            halt['a packed in_proj_weight takes keys and values of `emb` features, and they have `kdim` and `vdim`: use_separate_proj_weight']
        pr.in_w = math.flatten[math.zeros[1] + in_proj_weight]
        if len[pr.in_w] ne 3 * emb * emb
            halt['in_proj_weight takes `str[[3 * emb, emb]]`, and holds `len[pr.in_w]` numbers']
    if (len[pr.bias_k] eq 0) ne (len[pr.bias_v] eq 0)
        halt['bias_k and bias_v are given together, or neither']
    masks = masks_of[attn_mask, key_padding_mask, l, s, n, h, is_causal]
    p = dropout_p
    if not training
        p = 0.0
    width = s
    if len[pr.bias_k] gt 0
        width = width + 1
    if add_zero_attn
        width = width + 1
    keep = none
    if p gt 0.0 and p lt 1.0
        keep = noise_of[noise, n * h * l * width, 'multi_head_attention_forward']
    weighed = multi_head_flat[math.flatten[query], math.flatten[key], math.flatten[value], l, s, n, emb, kdim, vdim, h, pr, add_zero_attn, p, masks, need_weights, average_attn_weights, is_causal, keep]
    dims = [l, n, emb]
    if not batched
        dims = [l, emb]
    output = shapes.laid[weighed.output, dims]
    if not need_weights
        return Attention[output, none]
    wdims = [n, h, l, width]
    if average_attn_weights
        wdims = [n, l, width]
    if not batched
        wdims = slice[wdims, 1, len[wdims]]
    return Attention[output, shapes.laid[weighed.weights, wdims]]
