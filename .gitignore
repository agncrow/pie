# what crow builds and keeps beside a program: the build, the book derived
# on every start and the pid files `crow run` and `crow book` keep while
# they serve (the baseline and a request's recorded fixtures are the
# program's own, and tracked)
.crow_build/
target/
**/.crow/book/
**/.crow/*.pid
# the logs and data a program run here writes
*.csv
*.txt
*.json
# the OS and editors
.DS_Store
*.swp
*~
__pycache__/
# the book as a site, rendered by docs/book/site.co
docs/book/crow-site/
!packages/retrieval/reference/data/*.csv
!packages/retrieval/reference/expected/*.csv
!packages/gpt/reference/data/*.csv
!packages/gpt/reference/data/*.txt
!packages/gpt/reference/expected/*.csv
!packages/gpt/reference/expected/*.txt
!packages/vectors/reference/data/*.csv
!packages/vectors/reference/expected/*.csv
!packages/nn/reference/data/*.csv
!packages/nn/reference/expected/*.csv
!**/.crow/baseline/
!**/.crow/baseline/**
!**/.crow/fixtures/*.json
